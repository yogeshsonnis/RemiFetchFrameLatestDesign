            </Setter.Value>
        </Setter>
    </Style>-->

        <Style x:Key="RoundedButton" TargetType="Button">
            <Setter Property="Background" Value="#1567c0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Width" Value="150"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                        Background="{TemplateBinding Background}"
                        CornerRadius="8"
                        SnapsToDevicePixels="True"
                        >
                            <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#98bae8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1567c0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#FFBDBDBD"/>
                                <Setter Property="Foreground" Value="#FF7A7A7A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>


    </Window.Resources>

    <Grid Background="#f1f0f0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Background="#1567c0" Height="50">
            <StackPanel Orientation="Horizontal" Margin="24,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Cases" Foreground="White" FontSize="16" Margin="0,0,20,0" Cursor="Hand"/>
                <TextBlock Text="Settings" Foreground="White" FontSize="16" Margin="0,0,20,0" Cursor="Hand"/>
                <TextBlock Text="Quit" Foreground="White" FontSize="16" Cursor="Hand"/>
            </StackPanel>
            <TextBlock Text="V1.0.0" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="White" Margin="0,0,20,0"/>
        </DockPanel>
        <Grid Grid.Row="1" Margin="20,20,20,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Button Style="{StaticResource SimpleShadowButton}">
                        <TextBlock Text="Remi Fetch" Foreground="#1466c0" FontSize="22"/>
                    </Button>
                    <StackPanel Grid.Row="1" Margin="0,20,0,0">
                        <TextBlock Text="Collections" FontSize="17" FontWeight="SemiBold" Margin="5" Foreground="#417fc2"/>

                        <Border CornerRadius="7" BorderBrush="Gray" BorderThickness="0.5" Background="White" Height="37" Margin="0,0,0,10">
                            <TextBox Text="Targeted Collections" 
             Background="Transparent" 
             BorderThickness="0" 
             Foreground="Black" FontSize="15"  VerticalContentAlignment="Center"    
             Padding="5"/>
                        </Border>
                        <TextBlock Text="Extractions" FontSize="17" FontWeight="SemiBold" Margin="5" Foreground="#417fc2"  />
                        <Border CornerRadius="7" BorderBrush="Gray" BorderThickness="0.5" Background="White" Height="37" Margin="0,0,0,10">
                            <TextBox Text="Extract Data Form..." 
Background="Transparent" 
BorderThickness="0" 
Foreground="Black" FontSize="15"  VerticalContentAlignment="Center"    
Padding="5"/>
                        </Border>
                        <TextBlock Text="Preservations" FontSize="17" FontWeight="SemiBold" Margin="5" Foreground="#417fc2"  />
                        <Border CornerRadius="7" BorderBrush="Gray" BorderThickness="0.5" Background="White" Height="37" Margin="0,0,0,10">
                            <TextBox Text="Full Disk Windows" 
Background="Transparent" 
BorderThickness="0" 
Foreground="Black" FontSize="15"  VerticalContentAlignment="Center"    
Padding="5"/>
                        </Border>
                        <TextBlock Text="Tools" FontSize="17" FontWeight="SemiBold"  Margin="5" Foreground="#417fc2"/>
                        <Border CornerRadius="7" BorderBrush="Gray" BorderThickness="0.5" Background="White" Height="37" Margin="0,0,0,10">
                            <TextBox Text="Registry Parser" 
Background="Transparent" 
BorderThickness="0" 
Foreground="Black" FontSize="15"  VerticalContentAlignment="Center"    
Padding="5"/>
                        </Border>
                        <Border CornerRadius="7" BorderBrush="Gray" BorderThickness="0.5" Background="White" Height="37" Margin="0,0,0,10">
                            <TextBox Text="Boot Image " 
Background="Transparent" 
BorderThickness="0" 
Foreground="Black" FontSize="15"  VerticalContentAlignment="Center"    
Padding="5"/>
                        </Border>
                        <Border CornerRadius="7" BorderBrush="Gray" BorderThickness="0.5" Background="White" Height="37" Margin="0,0,0,10">
                            <TextBox Text="Event Log Organizer" 
Background="Transparent" 
BorderThickness="0" 
Foreground="Black" FontSize="15"  VerticalContentAlignment="Center"    
Padding="5"/>
                        </Border>
                        <Border CornerRadius="7" BorderBrush="Gray" BorderThickness="0.5" Background="White" Height="37" Margin="0,0,0,10">
                            <TextBox Text="Reporting" 
Background="Transparent" 
BorderThickness="0" 
Foreground="Black" FontSize="15"  VerticalContentAlignment="Center"    
Padding="5"/>
                        </Border>
                    </StackPanel>
                    <Border Grid.Row="2" Height="70" Style="{StaticResource CardStyle}">
                        <StackPanel>

                            <!-- Rounded ProgressBar Wrapper -->
                            <Border CornerRadius="7" Background="#E0E0E0">
                                <ProgressBar x:Name="MyProgressBar"
                         Minimum="0" Maximum="100" Value="35"
                         Height="10"
                         Foreground="#0078D7"
                         Background="Transparent"
                         BorderThickness="0"/>
                            </Border>

                            <TextBlock Text="Progress:35% | Idle"
                   Foreground="#417fc2"
                   FontSize="13"
                   HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
            <Grid></Grid>
            <Border Style="{StaticResource CardStyle}" Background="#fffeff" Grid.Column="1" >

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Content area cleared - ready for new module" Foreground="Gray" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="17"/>
                    <Button Grid.Row="1" Style="{StaticResource RoundedButton}"  HorizontalAlignment="Left"  FontSize="20" FontWeight="Regular">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M10,0 L0,10 L10,20"
              Stroke="White"
              StrokeThickness="2"
              Stretch="Uniform"
              Width="15" Height="15"
              Margin="0,0,8,0"/>

                            <TextBlock Text="Back" FontSize="17"/>
                        </StackPanel>
                    </Button>
                    <Button Grid.Row="1" Style="{StaticResource RoundedButton}" HorizontalAlignment="Right"  FontSize="20" FontWeight="Regular"  Click="NextButton_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Next" FontSize="17" Margin="0,0,8,0"/>

                            <Path Data="M0,0 L10,10 L0,20"
              Stroke="White"
              StrokeThickness="2"
              Stretch="Uniform"
              Width="15" Height="15"/>
                        </StackPanel>
                    </Button>

                </Grid>
            </Border>
        </Grid>



        <Border Grid.Row="2" Background="#1567c0" Height="30">
            <TextBlock Text="Status: Ready | No active jobs"
               Foreground="White"
               VerticalAlignment="Center"
               HorizontalAlignment="Right"
               FontSize="13" Margin="0,0,16,0"/>
        </Border>
    </Grid>
</Window>
