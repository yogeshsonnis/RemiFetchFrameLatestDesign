<Page x:Class="RemiFetchFrame.Views.ExtractFrom.FileGroups.TargetedCollectionsWizard1"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Targeted Collections Wizard - Step 1"
      Background="{DynamicResource AppBackgroundBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Progress Header -->
        <Border Background="{DynamicResource CardBackgroundBrush}" 
                CornerRadius="6" Padding="12" 
                BorderBrush="{DynamicResource BorderBrushGray}" BorderThickness="1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" >
                <TextBlock Text="1. Select Target Method"
                           Foreground="{DynamicResource PrimaryBrush}"
                           FontWeight="Bold" />
                <TextBlock Text="→" Foreground="{DynamicResource TextMutedBrush}" Margin="10,0"/>
                <TextBlock Text="2. Choose Filters" Foreground="{DynamicResource TextMutedBrush}" />
                <TextBlock Text="→" Foreground="{DynamicResource TextMutedBrush}" Margin="10,0"/>
                <TextBlock Text="3. Collect &amp; Export" Foreground="{DynamicResource TextMutedBrush}" />
            </StackPanel>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="1" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition  Width="2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <!-- Left: Card Options -->
            <WrapPanel Margin="0,0,20,0" HorizontalAlignment="Stretch" VerticalAlignment="Top" ItemWidth="200" ItemHeight="120">
                <Button Content="By File Group"
                       
                        FontSize="14" Margin="10" Padding="10"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrushGray}"
                        Foreground="{DynamicResource TextDarkBrush}"
                        Click="ByFileGroup_Click">
                    
                </Button>

                <Button Content="By Hash List"
                        Style="{DynamicResource ButtonStyle}"
                        FontSize="14" Margin="10" Padding="10"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrushGray}"
                        Foreground="{DynamicResource TextDarkBrush}"/>

                <Button Content="By File Path"
                        Style="{DynamicResource ButtonStyle}"
                        FontSize="14" Margin="10" Padding="10"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrushGray}"
                        Foreground="{DynamicResource TextDarkBrush}"/>
            </WrapPanel>

            <!-- Right: Info -->
            <Border Background="{DynamicResource CardBackgroundBrush}" 
                    BorderBrush="{DynamicResource BorderBrushGray}" BorderThickness="1" CornerRadius="6" Padding="20">
                <StackPanel>
                    <TextBlock Text="Select a Target Collection Method"
                               FontWeight="Bold" FontSize="16"
                               Foreground="{DynamicResource TextDarkBrush}" Margin="0,0,0,10"/>
                    <TextBlock Text="Choose how you’d like to collect data. Each option offers tailored filters and workflows to support forensic efficiency."
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
