<Page x:Class="RemiFetchFrame.Views.ExtractFrom.FileGroups.FileGroupWizard3"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Targeted Collections Wizard - Step 3"
      Background="{DynamicResource AppBackgroundBrush}">

    <Grid Margin="20" >
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- Progress Header -->
        <Border Background="{DynamicResource CardBackgroundBrush}"
                CornerRadius="6" Padding="12"
                BorderBrush="{DynamicResource BorderBrushGray}" BorderThickness="1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" >
                <TextBlock Text="1. Select Target Method"
                           Foreground="{DynamicResource TextMutedBrush}" />
                <TextBlock Text="→" Foreground="{DynamicResource TextMutedBrush}" Margin="10,0"/>
                <TextBlock Text="2. Choose Filters"
                           Foreground="{DynamicResource TextMutedBrush}" />
                <TextBlock Text="→" Foreground="{DynamicResource TextMutedBrush}" Margin="10,0"/>
                <TextBlock Text="3. Collect &amp; Export"
                           Foreground="{DynamicResource PrimaryBrush}"
                           FontWeight="Bold" />
            </StackPanel>
        </Border>

        <!-- Summary Panel -->
        <Border Grid.Row="1"
                Background="{DynamicResource CardBackgroundBrush}"
                CornerRadius="6" Padding="20"
                BorderBrush="{DynamicResource BorderBrushGray}" BorderThickness="1"
                Margin="0,20,0,20">
            <StackPanel>
                <TextBlock Text="Summary and Metrics"
                           FontWeight="Bold" FontSize="16"
                           Foreground="{DynamicResource TextDarkBrush}" Margin="0,0,0,10"/>
                <TextBlock Text="Below is a summary of the filters and data selections you've applied."
                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,15"/>

                <Grid Margin="0,5,0,15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Selected Categories:"
                               FontWeight="Bold" Foreground="{DynamicResource TextDarkBrush}" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Documents, Media, Databases"
                               Foreground="{DynamicResource TextMutedBrush}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Date Range:"
                               FontWeight="Bold" Foreground="{DynamicResource TextDarkBrush}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="Jan 01, 2023 – Dec 31, 2023"
                               Foreground="{DynamicResource TextMutedBrush}" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Sources Searched:"
                               FontWeight="Bold" Foreground="{DynamicResource TextDarkBrush}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="All Mounted Drives, Cloud Storage"
                               Foreground="{DynamicResource TextMutedBrush}" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Metrics:"
                               FontWeight="Bold" Foreground="{DynamicResource TextDarkBrush}" Margin="0,10,0,0"/>
                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Vertical" Margin="0,10,0,0">
                        <TextBlock Text="Files Collected: 3" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBlock Text="Total Data Size: 375.4 MB" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBlock Text="Processing Rate: 42 files/sec" Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                </Grid>

                <Border Background="{DynamicResource AppBackgroundBrush}" Padding="10" CornerRadius="6">
                    <TextBlock Text="Review your settings above. Click 'Finish' to finalize collection and return to the dashboard."
                               Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- Navigation Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Back" Width="100" Margin="5" Click="Back_Click"/>
            <Button Content="Finish" Width="100" Margin="5"
                    Background="{DynamicResource PrimaryBrush}" Foreground="White"
                    Click="Finish_Click"/>
        </StackPanel>
    </Grid>
</Page>
