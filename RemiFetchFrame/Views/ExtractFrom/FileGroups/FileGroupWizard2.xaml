<Page x:Class="RemiFetchFrame.Views.ExtractFrom.FileGroups.FileGroupWizard2"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Targeted Collections Wizard - Step 2"
      Background="{DynamicResource AppBackgroundBrush}">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- Progress Header -->
        <Border Background="{DynamicResource CardBackgroundBrush}" 
                CornerRadius="6" Padding="12" 
                BorderBrush="{DynamicResource BorderBrushGray}" BorderThickness="1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" >
                <TextBlock Text="1. Select Target Method"
                           Foreground="{DynamicResource TextMutedBrush}" />
                <TextBlock Text="→" Foreground="{DynamicResource TextMutedBrush}" Margin="10,0"/>
                <TextBlock Text="2. Choose Filters"
                           Foreground="{DynamicResource PrimaryBrush}"
                           FontWeight="Bold" />
                <TextBlock Text="→" Foreground="{DynamicResource TextMutedBrush}" Margin="10,0"/>
                <TextBlock Text="3. Collect &amp; Export"
                           Foreground="{DynamicResource TextMutedBrush}" />
            </StackPanel>
        </Border>

        <!-- File Category + Filters -->
        <Grid Grid.Row="1" Margin="0,20,0,20" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <!-- File Categories -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Background="{DynamicResource CardBackgroundBrush}" 
                            Margin="0,0,15,0"
                            >
                    <TextBlock Text="Select File Categories"
                               FontWeight="Bold" FontSize="14"
                               Foreground="{DynamicResource TextDarkBrush}" Margin="0,0,0,10"/>

                    <!-- Category Template -->
                    <Expander Header="Documents &amp; Office Files" Margin="0,4">
                        <StackPanel>
                            <CheckBox Content=".doc, .xls, .ppt, .pdf" Margin="10,2"/>
                        </StackPanel>
                    </Expander>
                    <Expander Header="Mobile &amp; iTunes Backups" Margin="0,4">
                        <StackPanel>
                            <CheckBox Content=".ipa, .plist, .sqlite" Margin="10,2"/>
                        </StackPanel>
                    </Expander>
                    <Expander Header="User Profiles &amp; Accounts" Margin="0,4">
                        <StackPanel>
                            <CheckBox Content="AppData, NTUSER.DAT, SAM, SYSTEM" Margin="10,2"/>
                        </StackPanel>
                    </Expander>
                    <Expander Header="Incident Response" Margin="0,4">
                        <StackPanel>
                            <CheckBox Content="Registry Hives, Prefetch, Logs" Margin="10,2"/>
                        </StackPanel>
                    </Expander>
                    <Expander Header="Communications" Margin="0,4">
                        <StackPanel>
                            <CheckBox Content=".pst, .msg, .eml, .mbox" Margin="10,2"/>
                        </StackPanel>
                    </Expander>
                    <Expander Header="Media Files" Margin="0,4">
                        <StackPanel>
                            <CheckBox Content=".jpg, .mp4, .wav, .mov" Margin="10,2"/>
                        </StackPanel>
                    </Expander>
                    <Expander Header="Web Data &amp; Cookies" Margin="0,4">
                        <StackPanel>
                            <CheckBox Content="Cookies, History, Bookmarks" Margin="10,2"/>
                        </StackPanel>
                    </Expander>
                    <Expander Header="Databases" Margin="0,4">
                        <StackPanel>
                            <CheckBox Content=".sql, .db, .mdb, .accdb" Margin="10,2"/>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>

            <!-- Filters -->
            <StackPanel Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}" 
                        >
                <TextBlock Text="Date Range Filter"
                           FontWeight="Bold" FontSize="14"
                           Foreground="{DynamicResource TextDarkBrush}" Margin="0,0,0,10"/>
                <StackPanel Orientation="Vertical" >
                    <StackPanel Orientation="Horizontal" >
                        <TextBlock Text="Start:" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextDarkBrush}"/>
                        <DatePicker Width="140"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" >
                        <TextBlock Text="End:" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextDarkBrush}"/>
                        <DatePicker Width="140"/>
                    </StackPanel>
                </StackPanel>

                <Separator Margin="0,15"/>

                <TextBlock Text="Select Sources to Search"
                           FontWeight="Bold" FontSize="14"
                           Foreground="{DynamicResource TextDarkBrush}" Margin="0,0,0,8"/>
                <StackPanel>
                    <CheckBox Content="All Mounted Drives" Margin="5,2"/>
                    <CheckBox Content="USB Devices" Margin="5,2"/>
                    <CheckBox Content="Cloud Drives" Margin="5,2"/>
                    <CheckBox Content="Network Shares" Margin="5,2"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Navigation Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Back" Width="100" Margin="5" Click="Back_Click"/>
            <Button Content="Next" Width="100" Margin="5" 
                    Background="{DynamicResource PrimaryBrush}" Foreground="White"
                    Click="Next_Click"/>
        </StackPanel>
    </Grid>
</Page>
