<Page x:Class="RemiFetchFrame.Views.ExtractFrom.E01Files.ExtractFromE01Wizard1"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Extract From E01 - Step 1">

    <Grid Background="White" Margin="24">
        <StackPanel>
            <TextBlock Text="Step 1 – Select E01 Files"
                       FontSize="20" FontWeight="Bold"
                       Foreground="#1565C0" Margin="0,0,0,12"/>
            <TextBlock Text="Choose one or more E01 files to process:"/>
            <ListBox x:Name="FileList" Height="200" Margin="0,10,0,10"/>
            <Button Content="Browse..." Width="100" Height="28"/>
        </StackPanel>
    </Grid>
</Page>
