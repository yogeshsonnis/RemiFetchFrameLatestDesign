<Page x:Class="RemiFetchFrame.Views.ExtractFrom.E01Files.ExtractFromE01Wizard3"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Extract From E01 - Step 3">

    <Grid Background="White" >
        <StackPanel>
            <TextBlock Text="Step 3 – Review &amp; Confirm Extraction"
                       FontSize="20" FontWeight="Bold"
                       Foreground="#1565C0" Margin="0,0,0,12"/>

            <TextBlock Text="Review your selected options before starting extraction:"
                       Margin="0,0,0,8"/>

            <Border BorderBrush="#DDD" BorderThickness="1" Padding="10" CornerRadius="6" Background="#fafafa">
                <StackPanel>
                    <TextBlock Text="• Selected E01 files: (sample list placeholder)" Margin="0,2,0,2"/>
                    <TextBlock Text="• Artifacts to extract: File System, Registry, Event Logs" Margin="0,2,0,2"/>
                    <TextBlock Text="• Output Path: C:\Cases\SquirrelVsRacoon\E01Output" Margin="0,2,0,2"/>
                    <TextBlock Text="• Compression: ZIP" Margin="0,2,0,2"/>
                </StackPanel>
            </Border>

            <Separator Margin="0,12,0,12"/>

            <TextBlock Text="Click 'Next' to begin extraction."
                       FontWeight="SemiBold" Margin="0,0,0,6"/>

            <ProgressBar x:Name="ProgressE01" Height="14" Value="0" Minimum="0" Maximum="100"
                         Foreground="#1565C0" Visibility="Collapsed"/>
            <TextBlock x:Name="LblProgress" Text="" FontStyle="Italic" Margin="0,4,0,0"/>
        </StackPanel>
    </Grid>
</Page>
