<Page x:Class="RemiFetchFrame.Views.ExtractFrom.E01Files.ExtractFromE01Wizard2"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Extract From E01 - Step 2">

    <Grid Background="White" >
        <StackPanel>
            <TextBlock Text="Step 2 – Configure Extraction Options"
                       FontSize="20" FontWeight="Bold"
                       Foreground="#1565C0" Margin="0,0,0,12"/>

            <TextBlock Text="Choose what to extract from the selected E01 files:"
                       Margin="0,0,0,8"/>

            <CheckBox Content="File System Artifacts" Margin="0,4,0,0"/>
            <CheckBox Content="Windows Registry Hives" Margin="0,4,0,0"/>
            <CheckBox Content="Event Logs" Margin="0,4,0,0"/>
            <CheckBox Content="Browser Artifacts" Margin="0,4,0,0"/>
            <CheckBox Content="User Documents" Margin="0,4,0,0"/>

            <Separator Margin="0,12,0,12"/>

            <TextBlock Text="Output Destination:"/>
            <TextBox x:Name="TxtOutputPath" Height="26" Margin="0,4,0,0"/>
            <Button Content="Browse..." Width="100" Height="26" Margin="0,8,0,0"/>

            <TextBlock Text="Compression:" Margin="0,8,0,0"/>
            <ComboBox Width="180" Margin="0,4,0,0">
                <ComboBoxItem Content="None"/>
                <ComboBoxItem Content="ZIP"/>
                <ComboBoxItem Content="7z"/>
            </ComboBox>
        </StackPanel>
    </Grid>
</Page>
