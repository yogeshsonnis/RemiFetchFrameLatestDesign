<Page x:Class="RemiFetchFrame.Views.ExtractFrom.iTunes.iTunesWizard3"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Extract from iTunes - Step 3"
      Background="{DynamicResource AppBackgroundBrush}">

    <Grid Margin="20" >
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- Progress Header -->
        <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6" Padding="12"
                BorderBrush="{DynamicResource BorderBrushGray}" BorderThickness="1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" >
                <TextBlock Text="1. Select Source" Foreground="{DynamicResource TextMutedBrush}"/>
                <TextBlock Text="→" Foreground="{DynamicResource TextMutedBrush}" Margin="10,0"/>
                <TextBlock Text="2. Choose Data Types" Foreground="{DynamicResource TextMutedBrush}"/>
                <TextBlock Text="→" Foreground="{DynamicResource TextMutedBrush}" Margin="10,0"/>
                <TextBlock Text="3. Extract &amp; Export" Foreground="{DynamicResource PrimaryBrush}" FontWeight="Bold"/>
            </StackPanel>
        </Border>

        <!-- Extraction UI -->
        <Grid Grid.Row="1" Margin="0,20,0,20" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>
            <!-- Extraction Queue -->
            <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6" Padding="15" Margin="0,0,20,0"
                    BorderBrush="{DynamicResource BorderBrushGray}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Extraction Progress" FontWeight="Bold" FontSize="14"
                               Foreground="{DynamicResource TextDarkBrush}" Margin="0,0,0,10"/>
                    <ProgressBar Height="20" Minimum="0" Maximum="100" Value="60" Margin="0,0,0,10"/>
                    <ListBox Height="200">
                        <ListBoxItem>Backup 1: 60% complete</ListBoxItem>
                        <ListBoxItem>Backup 2: 30% complete</ListBoxItem>
                        <ListBoxItem>Backup 3: Pending</ListBoxItem>
                    </ListBox>
                </StackPanel>
            </Border>

            <!-- Metrics -->
            <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6" Padding="15"
                    BorderBrush="{DynamicResource BorderBrushGray}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Metrics Summary" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextDarkBrush}" Margin="0,0,0,10"/>
                    <TextBlock Text="Files Collected: 4,720" Foreground="{DynamicResource TextMutedBrush}"/>
                    <TextBlock Text="Data Extracted: 18.6 GB" Foreground="{DynamicResource TextMutedBrush}"/>
                    <TextBlock Text="Elapsed Time: 00:08:47" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,10"/>
                    <TextBlock Text="Export Location: D:\\Evidence\\iTunesBackups" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Navigation -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Back" Width="100" Margin="5" Click="Back_Click"/>
            <Button Content="Finish" Width="100" Margin="5" 
                    Background="{DynamicResource PrimaryBrush}" Foreground="White"
                    Click="Finish_Click"/>
        </StackPanel>
    </Grid>
</Page>
