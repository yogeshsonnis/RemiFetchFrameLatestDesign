<Page x:Class="RemiFetchFrame.Views.ExtractFrom.iTunes.iTunesWizard2"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Extract from iTunes - Step 2"
      Background="{DynamicResource AppBackgroundBrush}">

    <Grid Margin="20" >
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- Progress Header -->
        <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6" Padding="12"
                BorderBrush="{DynamicResource BorderBrushGray}" BorderThickness="1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" >
                <TextBlock Text="1. Select Source" Foreground="{DynamicResource TextMutedBrush}"/>
                <TextBlock Text="→" Foreground="{DynamicResource TextMutedBrush}" Margin="10,0"/>
                <TextBlock Text="2. Choose Data Types" Foreground="{DynamicResource PrimaryBrush}" FontWeight="Bold"/>
                <TextBlock Text="→" Foreground="{DynamicResource TextMutedBrush}" Margin="10,0"/>
                <TextBlock Text="3. Extract &amp; Export" Foreground="{DynamicResource TextMutedBrush}"/>
            </StackPanel>
        </Border>

        <!-- Category Selection -->
        <ScrollViewer Grid.Row="1" Margin="0,20,0,20" VerticalScrollBarVisibility="Auto">
            <StackPanel Background="{DynamicResource CardBackgroundBrush}" 
                        >
                <TextBlock Text="Select Data Categories to Extract"
                           FontWeight="Bold" FontSize="14"
                           Foreground="{DynamicResource TextDarkBrush}" Margin="0,0,0,10"/>

                <Expander Header="Messages &amp; Chats" IsExpanded="True" Margin="0,4">
                    <StackPanel>
                        <CheckBox Content="SMS / iMessage" Margin="10,2"/>
                        <CheckBox Content="WhatsApp / Viber / Telegram" Margin="10,2"/>
                    </StackPanel>
                </Expander>

                <Expander Header="Contacts &amp; Call History" Margin="0,4">
                    <StackPanel>
                        <CheckBox Content="Address Book" Margin="10,2"/>
                        <CheckBox Content="Recent Calls" Margin="10,2"/>
                    </StackPanel>
                </Expander>

                <Expander Header="Media &amp; Photos" Margin="0,4">
                    <StackPanel>
                        <CheckBox Content="Camera Roll" Margin="10,2"/>
                        <CheckBox Content="Screenshots &amp; Thumbnails" Margin="10,2"/>
                    </StackPanel>
                </Expander>

                <Expander Header="App Data" Margin="0,4">
                    <StackPanel>
                        <CheckBox Content="App Configurations" Margin="10,2"/>
                        <CheckBox Content="App Databases" Margin="10,2"/>
                    </StackPanel>
                </Expander>

                <Expander Header="System Data" Margin="0,4">
                    <StackPanel>
                        <CheckBox Content="System Logs" Margin="10,2"/>
                        <CheckBox Content="Backup Metadata" Margin="10,2"/>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <!-- Navigation -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Back" Width="100" Margin="5" Click="Back_Click"/>
            <Button Content="Next" Width="100" Margin="5" 
                    Background="{DynamicResource PrimaryBrush}" Foreground="White"
                    Click="Next_Click"/>
        </StackPanel>
    </Grid>
</Page>
