<Page x:Class="RemiFetchFrame.Views.ExtractFrom.VM.VMWizard2"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Extract from VM - Step 2"
      Background="{DynamicResource AppBackgroundBrush}">

    <Grid Margin="20" >
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- Progress Header -->
        <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6" Padding="12"
                BorderBrush="{DynamicResource BorderBrushGray}" BorderThickness="1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" >
                <TextBlock Text="1. Select Source" Foreground="{DynamicResource TextMutedBrush}"/>
                <TextBlock Text="→" Foreground="{DynamicResource TextMutedBrush}" Margin="10,0"/>
                <TextBlock Text="2. Choose Data Types" Foreground="{DynamicResource PrimaryBrush}" FontWeight="Bold"/>
                <TextBlock Text="→" Foreground="{DynamicResource TextMutedBrush}" Margin="10,0"/>
                <TextBlock Text="3. Extract &amp; Export" Foreground="{DynamicResource TextMutedBrush}"/>
            </StackPanel>
        </Border>

        <!-- Categories -->
        <ScrollViewer Grid.Row="1" Margin="0,20,0,20" VerticalScrollBarVisibility="Auto">
            <StackPanel Background="{DynamicResource CardBackgroundBrush}" 
                       >
                <TextBlock Text="Select Data Categories to Extract" FontWeight="Bold" FontSize="14"
                           Foreground="{DynamicResource TextDarkBrush}" Margin="0,0,0,10"/>

                <Expander Header="System Artifacts" IsExpanded="True" Margin="0,4">
                    <StackPanel>
                        <CheckBox Content="Event Logs" Margin="10,2"/>
                        <CheckBox Content="Registry Hives" Margin="10,2"/>
                        <CheckBox Content="Prefetch Files" Margin="10,2"/>
                    </StackPanel>
                </Expander>

                <Expander Header="User Communications" Margin="0,4">
                    <StackPanel>
                        <CheckBox Content="Email Databases (.PST, .OST)" Margin="10,2"/>
                        <CheckBox Content="Chat Logs" Margin="10,2"/>
                    </StackPanel>
                </Expander>

                <Expander Header="Browser Activity" Margin="0,4">
                    <StackPanel>
                        <CheckBox Content="Cookies &amp; Cache" Margin="10,2"/>
                        <CheckBox Content="History &amp; Downloads" Margin="10,2"/>
                    </StackPanel>
                </Expander>

                <Expander Header="Multimedia &amp; Documents" Margin="0,4">
                    <StackPanel>
                        <CheckBox Content="Images, Audio, Video" Margin="10,2"/>
                        <CheckBox Content="Documents (.doc, .pdf, .xls)" Margin="10,2"/>
                    </StackPanel>
                </Expander>

                <Expander Header="Application Data" Margin="0,4">
                    <StackPanel>
                        <CheckBox Content="Databases" Margin="10,2"/>
                        <CheckBox Content="Configuration Files" Margin="10,2"/>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <!-- Navigation -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Back" Width="100" Margin="5" Click="Back_Click"/>
            <Button Content="Next" Width="100" Margin="5"
                    Background="{DynamicResource PrimaryBrush}" Foreground="White"
                    Click="Next_Click"/>
        </StackPanel>
    </Grid>
</Page>
