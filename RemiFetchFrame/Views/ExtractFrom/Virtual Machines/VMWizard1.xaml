<Page x:Class="RemiFetchFrame.Views.ExtractFrom.VM.VMWizard1"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Extract from VM - Step 1"
      Background="{DynamicResource AppBackgroundBrush}">

    <Grid Margin="20" >
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- Progress Header -->
        <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6" Padding="12"
                BorderBrush="{DynamicResource BorderBrushGray}" BorderThickness="1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" >
                <TextBlock Text="1. Select Source" Foreground="{DynamicResource PrimaryBrush}" FontWeight="Bold"/>
                <TextBlock Text="→" Foreground="{DynamicResource TextMutedBrush}" Margin="10,0"/>
                <TextBlock Text="2. Choose Data Types" Foreground="{DynamicResource TextMutedBrush}"/>
                <TextBlock Text="→" Foreground="{DynamicResource TextMutedBrush}" Margin="10,0"/>
                <TextBlock Text="3. Extract &amp; Export" Foreground="{DynamicResource TextMutedBrush}"/>
            </StackPanel>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="1" Margin="0,20,0,20" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <!-- Left: VM Source Table -->
            <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6" BorderBrush="{DynamicResource BorderBrushGray}" BorderThickness="1" Padding="15" Margin="0,0,20,0">
                <StackPanel>
                    <TextBlock Text="Imported Virtual Machines" FontWeight="Bold" FontSize="14"
                               Foreground="{DynamicResource TextDarkBrush}" Margin="0,0,0,10"/>
                    <DataGrid AutoGenerateColumns="False" Height="300" HeadersVisibility="Column"
                              BorderBrush="{DynamicResource BorderBrushGray}" BorderThickness="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="VM Name" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Location" Binding="{Binding Path}" Width="2*"/>
                            <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="Auto"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="Add Folder" Width="100" Margin="5"/>
                        <Button Content="Remove Selected" Width="130" Margin="5"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Right: Metrics -->
            <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6" Padding="15"
                    BorderBrush="{DynamicResource BorderBrushGray}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Source Summary" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextDarkBrush}" Margin="0,0,0,8"/>
                    <TextBlock Text="Detected VM Backups: 3" Foreground="{DynamicResource TextMutedBrush}"/>
                    <TextBlock Text="Total Data Size: 124 GB" Foreground="{DynamicResource TextMutedBrush}"/>
                    <TextBlock Text="Last Scan: Today" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,10"/>
                    <Button Content="Rescan" Width="100" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Navigation -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Next" Width="100" Background="{DynamicResource PrimaryBrush}" Foreground="White" Click="Next_Click"/>
        </StackPanel>
    </Grid>
</Page>
