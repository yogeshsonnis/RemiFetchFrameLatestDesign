<UserControl x:Class="Remi.Fetch.Views.Extract_From_iTunes.ExtractFromiTunesWizard3"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Remi.Fetch.Views.Extract_From_iTunes"
             mc:Ignorable="d" 
            >
    <Grid  Background="#fafafa">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Wizard Header -->
        <Border Grid.Row="0" Background="#f5f5f5" BorderBrush="#d1d5db" BorderThickness="0,0,0,1" Padding="20,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                    <Border Background="#e5e7eb" CornerRadius="100" Width="28" Height="28">
                        <TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#374151" FontWeight="SemiBold"/>
                    </Border>
                    <TextBlock Text=" Select iTunes Backup " Margin="8,0,0,0" Foreground="#4b5563" FontSize="13"/>
                </StackPanel>
                <Rectangle Fill="#d1d5db" Width="40" Height="1" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" Margin="10,0,10,0">
                    <Border Background="#e5e7eb" CornerRadius="100" Width="28" Height="28">
                        <TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#374151" FontWeight="SemiBold"/>
                    </Border>
                    <TextBlock Text=" Collect &amp; Export " Margin="8,0,0,0" Foreground="#4b5563" FontSize="13"/>
                </StackPanel>
                <Rectangle Fill="#d1d5db" Width="40" Height="1" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal">
                    <Border Background="#1565c0" CornerRadius="100" Width="28" Height="28">
                        <TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontWeight="SemiBold"/>
                    </Border>
                    <TextBlock Text=" Extract &amp; Export " Margin="8,0,0,0" Foreground="#1565c0" FontSize="13" FontWeight="SemiBold"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Main Body -->
        <StackPanel Grid.Row="1" Margin="10" Background="White"  Orientation="Vertical">
            <StackPanel Orientation="Horizontal"  Margin="0,0,0,15">
                <TextBlock Text="Step 3: Extract &amp; Export Results" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Foreground="#1f2937"/>
                <Button x:Name="BtnStart" Style="{StaticResource RoundedButton}" Content="Start Export" Width="120" Height="32" Background="#1565c0" Foreground="White" BorderThickness="0" Click="OnStart" Margin="30,0,0,0"/>
            </StackPanel>

            <!-- Progress Card -->
            <Border BorderBrush="#d1d5db" BorderThickness="1" CornerRadius="6" Padding="15" Background="#f9fafb" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="Preparing iTunes data extraction package…" Foreground="#374151" FontSize="13" Margin="0,0,0,5"/>
                    <ProgressBar x:Name="ExportProgress"  Style="{StaticResource RoundedProgressBar}" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal" >
                        <TextBlock Text="65 % Completed" FontSize="12" Foreground="#4b5563"/>
                        <TextBlock Text="ETA 00:01:32" FontSize="12" Foreground="#4b5563"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Summary Cards -->
            <UniformGrid Columns="3" Rows="1" Margin="0,0,0,10">
                <Border BorderBrush="#d1d5db" BorderThickness="1" CornerRadius="6" Padding="15" Background="White" Margin="5">
                    <StackPanel>
                        <TextBlock Text="Export Summary" FontWeight="Bold" FontSize="14" Foreground="#1f2937" Margin="0,0,0,8"/>
                        <TextBlock Text="Files Collected: 235" FontSize="12" Foreground="#374151"/>
                        <TextBlock Text="Data Size: 4.3 GB" FontSize="12" Foreground="#374151"/>
                        <TextBlock Text="Format: Forensic ZIP" FontSize="12" Foreground="#374151"/>
                        <TextBlock Text="Destination: E:/Case_iTunes/Exports/" FontSize="12" Foreground="#374151"/>
                    </StackPanel>
                </Border>

                <Border BorderBrush="#d1d5db" BorderThickness="1" CornerRadius="6" Padding="15" Background="White" Margin="5">
                    <StackPanel>
                        <TextBlock Text="Chain of Custody" FontWeight="Bold" FontSize="14" Foreground="#1f2937" Margin="0,0,0,8"/>
                        <TextBox Text="Custodian" Margin="0,0,0,6" FontSize="12" Padding="4" BorderBrush="#d1d5db" Style="{StaticResource RoundedPlaceholderTextBox}" Height="32"/>
                        <TextBox Text="Examiner" Margin="0,0,0,6" FontSize="12" Padding="4" BorderBrush="#d1d5db" Style="{StaticResource RoundedPlaceholderTextBox}" Height="32"/>
                        <TextBox Text="Verification Notes" FontSize="12" Padding="4" BorderBrush="#d1d5db" Style="{StaticResource RoundedPlaceholderTextBox}" Height="32"/>
                    </StackPanel>
                </Border>

                <Border BorderBrush="#d1d5db" BorderThickness="1" CornerRadius="6" Padding="15" Background="White" Margin="5">
                    <StackPanel>
                        <TextBlock Text="Metrics" FontWeight="Bold" FontSize="14" Foreground="#1f2937" Margin="0,0,0,8"/>
                        <TextBlock Text="Average File Size: 56 KB" FontSize="12" Foreground="#374151"/>
                        <TextBlock Text="Processing Rate: 42 files/s" FontSize="12" Foreground="#374151"/>
                        <TextBlock Text="Errors Detected: 0" FontSize="12" Foreground="#374151"/>
                        <TextBlock Text="Duration: 2 m 31 s" FontSize="12" Foreground="#374151"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Footer -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button x:Name="BtnFinish" Style="{StaticResource RoundedButton}" Content="Finish ✓" Width="120" Height="32"
                        Background="#1565c0" Foreground="White"
                        BorderThickness="0" Click="OnFinish"/>
            </StackPanel>
        </StackPanel>
    </Grid>

</UserControl>
