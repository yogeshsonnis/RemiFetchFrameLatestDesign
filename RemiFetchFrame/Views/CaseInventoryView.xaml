<Window x:Class="RemiFetchFrame.Views.CaseInventoryView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:RemiFetchFrame.Views"
      mc:Ignorable="d" 
      Title="CaseInventoryView">

    <Viewbox Stretch="Uniform" StretchDirection="Both" Margin="20">
        <Grid Width="980" Height="660" Background="#F5F7FA">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Orientation="Vertical" Margin="0,0,0,20" HorizontalAlignment="Center">
                <TextBlock Text="Case Inventory"
                        FontSize="26"
                        FontWeight="Bold"
                        Foreground="#333"
                        HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding Name}"
                        FontSize="14"
                        Foreground="#666"
                        HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Main Card -->
            <Border Grid.Row="1"
                 Background="White"
                 CornerRadius="12"
                 Padding="30"
                 BorderBrush="#E0E3E8"
                 BorderThickness="1"
                 >
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Inventory Header -->
                    <TextBlock Text="Collected Devices and Evidence"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="#333"
                            Margin="0,0,0,10"/>

                    <!-- Evidence List -->
                    <ListView x:Name="InventoryList"
                           Grid.Row="1"
                           BorderThickness="0"
                           Background="White"
                           Foreground="#333"
                           AlternationCount="2"
                           Margin="0,0,0,10">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Device Name" Width="220" DisplayMemberBinding="{Binding DeviceName}" />
                                <GridViewColumn Header="Type" Width="120" DisplayMemberBinding="{Binding DeviceType}" />
                                <GridViewColumn Header="Date Collected" Width="180" DisplayMemberBinding="{Binding CollectedDate}" />
                                <GridViewColumn Header="Status" Width="120" DisplayMemberBinding="{Binding Status}" />
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <!-- Footer Buttons -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" >
                        <Button Content="Add Evidence"
                                Click="Button_Click"
                             Width="160"
                             Height="45"
                             Background="#0066CC"
                             Foreground="White"
                             FontWeight="SemiBold"
                             BorderThickness="0"
                             Cursor="Hand"
                             /> <!--Click="BtnAddEvidence_Click"-->

                        <Button Content="Collect More Data"
                             Width="200"
                             Height="45"
                             Background="#E5E8ED"
                             Foreground="#333"
                             FontWeight="SemiBold"
                             BorderBrush="#D0D4D8"
                             Cursor="Hand"
                             /> <!--Click="CollectMoreData_Click"-->

                        <Button Content="Back"
                             Width="120"
                             Height="45"
                             Background="#FFFFFF"
                             Foreground="#333"
                             FontWeight="SemiBold"
                             BorderBrush="#D0D4D8"
                             Cursor="Hand"
                             /> <!--Click="BtnBack_Click"-->
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Footer Text -->
            <TextBlock Grid.Row="2"
                    Text="Evidence is automatically linked to the current case repository."
                    FontSize="12"
                    Foreground="#888"
                    HorizontalAlignment="Center"
                    Margin="0,20,0,0"/>
        </Grid>
    </Viewbox>
</Window>
