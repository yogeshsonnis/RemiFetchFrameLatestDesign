<UserControl x:Class="RemiFetchFrame.Views.CollectByPathWizard2"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RemiFetchFrame.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="20" Background="#fafafa">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Wizard Header -->
        <Border Grid.Row="0" Background="#f5f5f5"
                BorderBrush="#d1d5db" BorderThickness="0,0,0,1"
                Padding="20,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6">
                    <Border Background="#e5e7eb" CornerRadius="100" Width="28" Height="28">
                        <TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="#374151" FontWeight="SemiBold"/>
                    </Border>
                    <TextBlock Text="Add Paths" Foreground="#4b5563" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>

                <Rectangle Fill="#d1d5db" Width="40" Height="1" VerticalAlignment="Center" Margin="5,0"/>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6">
                    <Border Background="#1565c0" CornerRadius="100" Width="28" Height="28">
                        <TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="White" FontWeight="SemiBold"/>
                    </Border>
                    <TextBlock Text="Collect &amp; Export" Foreground="#1565c0"
                               FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Main Body -->
        <StackPanel Grid.Row="1" Margin="10" Background="White" Orientation="Vertical">

            <!-- Header Row -->
            <StackPanel Orientation="Horizontal"  Margin="0,0,0,15">
                <TextBlock Text="Step 2 – Collect &amp; Export Data from Paths"
                           FontSize="16" FontWeight="SemiBold" Foreground="#1f2937"/>
                <Button x:Name="BtnStartExport" Content="Start Export"
                        Width="120" Height="32" Background="#1565c0"
                        Foreground="White" BorderThickness="0" Click="OnStartExport"/>
            </StackPanel>

            <!-- Export Progress Table -->
            <Border BorderBrush="#d1d5db" BorderThickness="1" CornerRadius="6"
                    Padding="15" Background="#f9fafb" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="Export Progress" FontWeight="SemiBold" FontSize="14"
                               Foreground="#1f2937" Margin="0,0,0,8"/>
                    <DataGrid x:Name="ExportGrid"
                              AutoGenerateColumns="False" CanUserAddRows="False"
                              AlternatingRowBackground="#f9fafb"
                              Background="White" BorderBrush="#d1d5db" BorderThickness="1"
                              FontSize="12" Height="200">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="2*"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/>
                            <DataGridTextColumn Header="Progress" Binding="{Binding Progress}" Width="*"/>
                            <DataGridTextColumn Header="Output File" Binding="{Binding Output}" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <ProgressBar x:Name="ExportProgress" Value="60" Height="10"
                                 Foreground="#1565c0" Background="#e5e7eb"
                                 Margin="0,10,0,6"/>
                    <StackPanel Orientation="Horizontal" >
                        <TextBlock Text="60 % Completed" FontSize="12" Foreground="#4b5563"/>
                        <TextBlock Text="ETA 00:02:05" FontSize="12" Foreground="#4b5563"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Summary Cards -->
            <UniformGrid Columns="3" Rows="1" Margin="0,0,0,10">
                <!-- Export Summary -->
                <Border BorderBrush="#d1d5db" BorderThickness="1" CornerRadius="6"
                        Padding="15" Background="#f9fafb" Margin="5">
                    <StackPanel>
                        <TextBlock Text="Export Summary" FontWeight="SemiBold" FontSize="14"
                                   Foreground="#1f2937" Margin="0,0,0,6"/>
                        <TextBlock Text="Files Exported: 972" FontSize="12" Foreground="#374151"/>
                        <TextBlock Text="Data Size: 2.4 GB" FontSize="12" Foreground="#374151"/>
                        <TextBlock Text="Destination: E:/Collected_Paths/" FontSize="12" Foreground="#374151"/>
                    </StackPanel>
                </Border>

                <!-- Chain of Custody -->
                <Border BorderBrush="#d1d5db" BorderThickness="1" CornerRadius="6"
                        Padding="15" Background="#f9fafb" Margin="5">
                    <StackPanel>
                        <TextBlock Text="Chain of Custody" FontWeight="SemiBold" FontSize="14"
                                   Foreground="#1f2937" Margin="0,0,0,6"/>
                        <TextBox Text="Custodian" Margin="0,0,0,6"
                                 FontSize="12" Padding="4" BorderBrush="#d1d5db"/>
                        <TextBox Text="Examiner" Margin="0,0,0,6"
                                 FontSize="12" Padding="4" BorderBrush="#d1d5db"/>
                        <TextBox Text="Notes" FontSize="12" Padding="4"
                                 BorderBrush="#d1d5db"/>
                    </StackPanel>
                </Border>

                <!-- Metrics -->
                <Border BorderBrush="#d1d5db" BorderThickness="1" CornerRadius="6"
                        Padding="15" Background="#f9fafb" Margin="5">
                    <StackPanel>
                        <TextBlock Text="Metrics" FontWeight="SemiBold" FontSize="14"
                                   Foreground="#1f2937" Margin="0,0,0,6"/>
                        <TextBlock Text="Average File Size: 28 KB" FontSize="12" Foreground="#374151"/>
                        <TextBlock Text="Processing Rate: 75 files/s" FontSize="12" Foreground="#374151"/>
                        <TextBlock Text="Errors: 0" FontSize="12" Foreground="#374151"/>
                        <TextBlock Text="Duration: 2 m 04 s" FontSize="12" Foreground="#374151"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Footer -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button x:Name="BtnFinish" Content="Finish ✓"
                        Width="120" Height="32" Background="#1565c0"
                        Foreground="White" BorderThickness="0"
                        FontSize="13" Click="OnFinish"/>
            </StackPanel>
        </StackPanel>
    </Grid>

</UserControl>
