<Window x:Class="RemiFetchFrame.Views.SplashScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RemiFetchFrame.Views"
        mc:Ignorable="d"
        Title="SplashScreen" Height="450" Width="800">
    
    
    
<Border CornerRadius="16" Background="Black" BorderBrush="#1565c0" BorderThickness="2"
        Padding="0" SnapsToDevicePixels="True" >
        <Grid>

             <!--🧾 Licensing Info--> 
            <TextBlock Text="Licensed to Cyber Forensics  |  www.cyberforensics.ai"
                   Foreground="White" FontSize="12" Margin="20,16,0,0"
                   VerticalAlignment="Top" HorizontalAlignment="Left"
                   Opacity="0.9" FontWeight="SemiBold"/>

             <!--🐾 Fetch Branding Image--> 
            <Image Source="/Images/FetchSplash.png"
               Stretch="Uniform"
               VerticalAlignment="Center"
               HorizontalAlignment="Center"
               Width="700"
               Height="400"
               RenderOptions.BitmapScalingMode="HighQuality"/>

             <!--🧭 Progress + Spinner + Status--> 
            <StackPanel VerticalAlignment="Bottom" Margin="0,0,0,40" HorizontalAlignment="Center">

                 <!--Progress bar-->     
                <ProgressBar IsIndeterminate="True" Height="10" Width="420"
                         Foreground="#1565c0" Background="#e3f2fd"
                         BorderBrush="#1565c0" BorderThickness="0"
                          />

                 <!--Spinner--> 
                <Canvas Width="32" Height="32" Margin="0,16,0,0" HorizontalAlignment="Center">
                    <Ellipse Width="28" Height="28" Stroke="#1565c0" StrokeThickness="4"
                         StrokeDashArray="2 6" StrokeStartLineCap="Round"
                         RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <RotateTransform x:Name="SpinnerRotate" Angle="0"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Canvas.Triggers>
                        <EventTrigger RoutedEvent="Canvas.Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation
                                    Storyboard.TargetName="SpinnerRotate"
                                    Storyboard.TargetProperty="Angle"
                                    From="0" To="360"
                                    Duration="0:0:1.2" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Canvas.Triggers>
                </Canvas>

                 <!--Smooth fading status message--> 
                <TextBlock x:Name="StatusText"
                       Text="Loading configuration..."
                       Foreground="White" FontSize="14"
                       Margin="0,12,0,0"
                       TextAlignment="Center"
                       FontWeight="SemiBold"
                       Opacity="0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
