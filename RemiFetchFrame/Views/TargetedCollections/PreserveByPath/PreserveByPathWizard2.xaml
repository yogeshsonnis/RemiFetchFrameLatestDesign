<Page x:Class="RemiFetchFrame.Views.TargetedCollections.PreserveByPath.PreserveByPathWizard2"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Targeted Collections - Preserve by Path (Step 2)"
      Background="{DynamicResource AppBackgroundBrush}">

    <Grid Margin="20" >
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- Header -->
        <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6" Padding="12"
                BorderBrush="{DynamicResource BorderBrushGray}" BorderThickness="1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" >
                <TextBlock Text="1. Select Target Method" Foreground="{DynamicResource TextMutedBrush}"/>
                <TextBlock Text="→" Margin="10,0" Foreground="{DynamicResource TextMutedBrush}"/>
                <TextBlock Text="2. Preserve by Path" Foreground="{DynamicResource PrimaryBrush}" FontWeight="Bold"/>
                <TextBlock Text="→" Margin="10,0" Foreground="{DynamicResource TextMutedBrush}"/>
                <TextBlock Text="3. Collect &amp; Export" Foreground="{DynamicResource TextMutedBrush}"/>
            </StackPanel>
        </Border>

        <!-- Main Body -->
        <StackPanel Grid.Row="1" Margin="0,20,0,20" >
            <!-- Preserve Paths -->
            <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6"
                    BorderBrush="{DynamicResource BorderBrushGray}" BorderThickness="1" Padding="15">
                <Grid>
                <DockPanel Margin="0,0,0,10">
                    <TextBlock Text="Preserve by Path" DockPanel.Dock="Left" FontWeight="Bold" FontSize="14"
                               Foreground="{DynamicResource TextDarkBrush}"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" >
                        <Button Content="+" Width="25" Height="25" Background="Green" Foreground="White" FontWeight="Bold"/>
                        <Button Content="–" Width="25" Height="25" Background="Red" Foreground="White" FontWeight="Bold"/>
                        <Button Content="Browse" Width="70" Background="{DynamicResource PrimaryBrush}" Foreground="White"/>
                    </StackPanel>
                </DockPanel>

                <DataGrid AutoGenerateColumns="False" Height="120"
                          BorderBrush="{DynamicResource BorderBrushGray}" BorderThickness="1">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Path" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
                </Grid>
            </Border>

            <!-- Validation Preview -->
            <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6"
                    BorderBrush="{DynamicResource BorderBrushGray}" BorderThickness="1" Padding="15">
                <Grid>
                <DockPanel Margin="0,0,0,10">
                    <TextBlock Text="Validation &amp; Preview" DockPanel.Dock="Left" FontWeight="Bold" FontSize="14"
                               Foreground="{DynamicResource TextDarkBrush}"/>
                    <Button Content="Validate Paths" DockPanel.Dock="Right" 
                            Foreground="{DynamicResource TextDarkBrush}" Width="120"/> <!--Background="{DynamicResource GrayButtonBrush}"-->
                    </DockPanel>

                <DataGrid AutoGenerateColumns="False" Height="160"
                          BorderBrush="{DynamicResource BorderBrushGray}" BorderThickness="1">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Width="30"/>
                        <DataGridTextColumn Header="Path" Width="220"/>
                        <DataGridTextColumn Header="Status" Width="100"/>
                        <DataGridTextColumn Header="Permissions" Width="120"/>
                        <DataGridTextColumn Header="Type" Width="100"/>
                        <DataGridTextColumn Header="Owner" Width="100"/>
                        <DataGridTextColumn Header="Last Modified" Width="130"/>
                    </DataGrid.Columns>
                </DataGrid>
                </Grid>
            </Border>

            <!-- Metrics -->
            <Grid  HorizontalAlignment="Stretch" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- Metrics Summary -->
                <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6"
                        BorderBrush="{DynamicResource BorderBrushGray}" BorderThickness="1" Padding="10" Margin="5">
                    <StackPanel>
                        <TextBlock Text="Metrics Summary" FontWeight="Bold" Foreground="{DynamicResource TextDarkBrush}"/>
                        <TextBlock Text="Files Added: 1" Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock Text="Total Data Size: 1.2 GB" Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock Text="Duplicates Removed: 0" Foreground="{DynamicResource TextMutedBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Validation Summary -->
                <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6"
                        BorderBrush="{DynamicResource BorderBrushGray}" BorderThickness="1" Padding="10" Margin="5">
                    <StackPanel>
                        <TextBlock Text="File Validation Summary" FontWeight="Bold" Foreground="{DynamicResource TextDarkBrush}"/>
                        <TextBlock Text="Integrity Check: Passed" Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock Text="Hash Verification: SHA-256 generated" Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock Text="Unsupported Files: 0" Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock Text="Corrupted Files: 0" Foreground="{DynamicResource TextMutedBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Locked Files -->
                <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6"
                        BorderBrush="{DynamicResource BorderBrushGray}" BorderThickness="1" Padding="10" Margin="5">
                    <StackPanel>
                        <TextBlock Text="Permissions &amp; Locked Files" FontWeight="Bold" Foreground="{DynamicResource TextDarkBrush}"/>
                        <TextBlock Text="Accessible Files: 48" Foreground="Green"/>
                        <TextBlock Text="Restricted Files: 3" Foreground="Goldenrod"/>
                        <TextBlock Text="Locked Files: 2" Foreground="Red"/>
                        <TextBlock Text="Actions Required: 2 (Run as Admin / Unlock)"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>

        <!-- Navigation -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Back" Width="100" Margin="5" Click="Back_Click"/>
            <Button Content="Next" Width="100" Margin="5" Background="{DynamicResource PrimaryBrush}" Foreground="White"
                    Click="Next_Click"/>
        </StackPanel>
    </Grid>
</Page>
