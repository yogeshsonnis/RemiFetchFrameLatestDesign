<Page x:Class="RemiFetchFrame.Views.TargetedCollections.DragAndDrop.DragAndDropWizard2"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Targeted Collections - Drag &amp; Drop (Step 2)"
      Background="{DynamicResource AppBackgroundBrush}">

    <Grid Margin="20" >
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- Header Progress Bar -->
        <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6" Padding="12"
                BorderBrush="{DynamicResource BorderBrushGray}" BorderThickness="1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" >
                <TextBlock Text="1. Select Target Method" Foreground="{DynamicResource TextMutedBrush}" />
                <TextBlock Text="→" Foreground="{DynamicResource TextMutedBrush}" Margin="10,0"/>
                <TextBlock Text="2. Drag &amp; Drop - Setup" Foreground="{DynamicResource PrimaryBrush}" FontWeight="Bold"/>
                <TextBlock Text="→" Foreground="{DynamicResource TextMutedBrush}" Margin="10,0"/>
                <TextBlock Text="3. Collect &amp; Export" Foreground="{DynamicResource TextMutedBrush}" />
            </StackPanel>
        </Border>

        <!-- Main Body -->
        <StackPanel Grid.Row="1" Margin="0,20,0,20">
            <!-- Drag Drop Panel -->
            <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6"
                    BorderBrush="{DynamicResource BorderBrushGray}" BorderThickness="1"
                    Padding="20" HorizontalAlignment="Stretch">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Height="140" AllowDrop="True"
                            DragEnter="DragEnter_Handler" Drop="Drop_Handler">
                    <TextBlock Text="Drag &amp; Drop Files" FontWeight="Bold" FontSize="14"
                               Foreground="{DynamicResource TextDarkBrush}" TextAlignment="Center" />
                    <Border BorderThickness="2" BorderBrush="{DynamicResource BorderBrushGray}" CornerRadius="8"
                             Margin="10" Background="{DynamicResource AppBackgroundLightBrush}">
                        <TextBlock Text="Drag and drop files here or click to browse"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextMutedBrush}" Margin="20"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Files Table -->
            <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6"
                    BorderBrush="{DynamicResource BorderBrushGray}" BorderThickness="1" Padding="15">
                <StackPanel>
                    <TextBlock Text="Files Added to Collection" FontWeight="Bold" FontSize="14"
                               Foreground="{DynamicResource TextDarkBrush}" Margin="0,0,0,10"/>
                    <DataGrid Name="FilesDataGrid" AutoGenerateColumns="False" Height="200"
                              BorderThickness="1" BorderBrush="{DynamicResource BorderBrushGray}">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="" Width="30"/>
                            <DataGridTextColumn Header="Filename" Binding="{Binding FileName}" Width="*"/>
                            <DataGridTextColumn Header="File Type" Binding="{Binding FileType}" Width="100"/>
                            <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="80"/>
                            <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="200"/>
                            <DataGridTextColumn Header="File Status" Binding="{Binding Status}" Width="100"/>
                            <DataGridTemplateColumn Header="Action" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="✖" Foreground="Red" Width="25" Height="25"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Background="Transparent" BorderThickness="0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- Metrics Section -->
            <Grid  HorizontalAlignment="Stretch" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6"
                        BorderBrush="{DynamicResource BorderBrushGray}" BorderThickness="1"
                        Padding="10" Margin="5">
                    <StackPanel>
                        <TextBlock Text="Metrics Summary" FontWeight="Bold" Foreground="{DynamicResource TextDarkBrush}"/>
                        <TextBlock Text="Files Added: 1" Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock Text="Total Data Size: 1.2 GB" Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock Text="Duplicates Removed: 0" Foreground="{DynamicResource TextMutedBrush}"/>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6"
                        BorderBrush="{DynamicResource BorderBrushGray}" BorderThickness="1"
                        Padding="10" Margin="5">
                    <StackPanel>
                        <TextBlock Text="File Validation Summary" FontWeight="Bold" Foreground="{DynamicResource TextDarkBrush}"/>
                        <TextBlock Text="Integrity Check: Passed" Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock Text="Hash Verification: SHA-256 Generated" Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock Text="Unsupported Files: 0" Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock Text="Corrupted Files: 0" Foreground="{DynamicResource TextMutedBrush}"/>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6"
                        BorderBrush="{DynamicResource BorderBrushGray}" BorderThickness="1"
                        Padding="10" Margin="5">
                    <StackPanel>
                        <TextBlock Text="Permissions &amp; Locked Files" FontWeight="Bold" Foreground="{DynamicResource TextDarkBrush}"/>
                        <TextBlock Text="Accessible Files: 48" Foreground="Green"/>
                        <TextBlock Text="Restricted Files: 3" Foreground="Goldenrod"/>
                        <TextBlock Text="Locked Files: 2" Foreground="Red"/>
                        <TextBlock Text="Actions Required: 2 (Run as Admin / Unlock)"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>

        <!-- Navigation -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Back" Width="100" Margin="5" Click="Back_Click"/>
            <Button Content="Next" Width="100" Margin="5"
                    Background="{DynamicResource PrimaryBrush}" Foreground="White"
                    Click="Next_Click"/>
        </StackPanel>
    </Grid>
</Page>
