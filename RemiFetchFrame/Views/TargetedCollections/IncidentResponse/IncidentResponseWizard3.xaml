<Page x:Class="RemiFetchFrame.Views.TargetedCollections.IncidentResponse.IncidentResponseWizard3"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Targeted Collections - Incident Response (Step 3)"
      Background="{DynamicResource AppBackgroundBrush}">

    <Grid Margin="20" >
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- Header -->
        <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6" Padding="12"
                BorderBrush="{DynamicResource BorderBrushGray}" BorderThickness="1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" >
                <TextBlock Text="1. Select Target Method" Foreground="{DynamicResource TextMutedBrush}" />
                <TextBlock Text="→" Foreground="{DynamicResource TextMutedBrush}" Margin="10,0"/>
                <TextBlock Text="2. Incident Response - Setup" Foreground="{DynamicResource TextMutedBrush}" />
                <TextBlock Text="→" Foreground="{DynamicResource TextMutedBrush}" Margin="10,0"/>
                <TextBlock Text="3. Collect &amp; Export" Foreground="{DynamicResource PrimaryBrush}" FontWeight="Bold"/>
            </StackPanel>
        </Border>

        <!-- Main Body -->
        <StackPanel Grid.Row="1" Margin="0,20,0,20" >
            <!-- Files Added -->
            <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6"
                    BorderBrush="{DynamicResource BorderBrushGray}" BorderThickness="1" Padding="15">
                <Grid>
                <TextBlock Text="Files Added to Collection" FontWeight="Bold" FontSize="14"
                           Foreground="{DynamicResource TextDarkBrush}" Margin="0,0,0,10"/>
                <DataGrid AutoGenerateColumns="False" Height="180"
                          BorderBrush="{DynamicResource BorderBrushGray}" BorderThickness="1">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Width="30"/>
                        <DataGridTextColumn Header="Filename" Width="*" />
                        <DataGridTextColumn Header="Path" Width="250" />
                        <DataGridTextColumn Header="Size" Width="80" />
                        <DataGridTextColumn Header="File Status" Width="100" />
                    </DataGrid.Columns>
                </DataGrid>
                </Grid>
            </Border>

            <!-- Collection Progress -->
            <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6"
                    BorderBrush="{DynamicResource BorderBrushGray}" BorderThickness="1" Padding="15">
                <Grid>
                <DockPanel>
                    <TextBlock Text="Collection &amp; Export Status" DockPanel.Dock="Left"
                               FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextDarkBrush}"/>
                    <Button Content="Start" DockPanel.Dock="Right" Width="90" Height="28"
                            Background="{DynamicResource PrimaryBrush}" Foreground="White"/>
                </DockPanel>

                <TextBlock Text="Collecting user files and preparing export package..."
                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,5"/>
                <ProgressBar Height="14" Minimum="0" Maximum="100" Value="65" Margin="0,5"/>
                <DockPanel>
                    <TextBlock Text="65% Completed" DockPanel.Dock="Left"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                    <TextBlock Text="Estimated Time: 00:01:32" DockPanel.Dock="Right"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                </DockPanel>
                </Grid>
            </Border>

            <!-- Metrics Section -->
            <Grid  HorizontalAlignment="Stretch" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6"
                        BorderBrush="{DynamicResource BorderBrushGray}" BorderThickness="1"
                        Padding="10" Margin="5">
                    <StackPanel>
                        <TextBlock Text="Export Summary" FontWeight="Bold"
                                   Foreground="{DynamicResource TextDarkBrush}"/>
                        <TextBlock Text="Total Files Collected: 235" Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock Text="Total Data Size: 4.3 GB" Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock Text="Export Format: Forensic ZIP" Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock Text="Location: E:\\Case123\\Exports\\" Foreground="{DynamicResource TextMutedBrush}"/>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6"
                        BorderBrush="{DynamicResource BorderBrushGray}" BorderThickness="1"
                        Padding="10" Margin="5">
                    <StackPanel>
                        <TextBlock Text="Metrics" FontWeight="Bold"
                                   Foreground="{DynamicResource TextDarkBrush}"/>
                        <TextBlock Text="Average File Size: 56 KB" Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock Text="Processing Rate: 42 files/sec" Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock Text="Errors Detected: 0" Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock Text="Duration: 2m 31s" Foreground="{DynamicResource TextMutedBrush}"/>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6"
                        BorderBrush="{DynamicResource BorderBrushGray}" BorderThickness="1"
                        Padding="10" Margin="5">
                    <StackPanel>
                        <TextBlock Text="Chain of Custody" FontWeight="Bold"
                                   Foreground="{DynamicResource TextDarkBrush}"/>
                        <TextBox Text="Custodian" Margin="0,4,0,0"/>
                        <TextBox Text="Agency" Margin="0,4,0,0"/>
                        <TextBox Text="Examiner" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>

        <!-- Navigation -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Back" Width="100" Margin="5" Click="Back_Click"/>
            <Button Content="Finish" Width="100" Margin="5"
                    Background="{DynamicResource PrimaryBrush}" Foreground="White"
                    Click="Finish_Click"/>
        </StackPanel>
    </Grid>
</Page>
