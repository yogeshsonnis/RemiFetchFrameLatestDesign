<Page x:Class="RemiFetchFrame.Views.TargetedCollections.IncidentResponse.IncidentResponseWizard2"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Targeted Collections - Incident Response (Step 2)"
      Background="{DynamicResource AppBackgroundBrush}">

    <Grid Margin="20" >
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- Header -->
        <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6" Padding="12"
                BorderBrush="{DynamicResource BorderBrushGray}" BorderThickness="1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="1. Select Target Method" Foreground="{DynamicResource TextMutedBrush}" />
                <TextBlock Text="→" Foreground="{DynamicResource TextMutedBrush}" Margin="10,0"/>
                <TextBlock Text="2. Incident Response - Setup" Foreground="{DynamicResource PrimaryBrush}" FontWeight="Bold"/>
                <TextBlock Text="→" Foreground="{DynamicResource TextMutedBrush}" Margin="10,0"/>
                <TextBlock Text="3. Collect &amp; Export" Foreground="{DynamicResource TextMutedBrush}" />
            </StackPanel>
        </Border>

        <!-- Main Body -->
        <StackPanel Grid.Row="1" Margin="0,20,0,20" >

            <!-- Discovery Controls -->
            <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6"
                    BorderBrush="{DynamicResource BorderBrushGray}" BorderThickness="1" Padding="15">
                <StackPanel>
                    <DockPanel>
                        <TextBlock Text="Incident Response Artifact Discovery" DockPanel.Dock="Left"
                                   FontWeight="Bold" FontSize="14"
                                   Foreground="{DynamicResource TextDarkBrush}"/>
                        <Button Content="Discover" DockPanel.Dock="Right" Width="90" Height="28"
                                Background="{DynamicResource PrimaryBrush}" Foreground="White"
                                Click="Discover_Click"/>
                    </DockPanel>

                    <TextBlock Text="Run a discovery scan to inventory available forensic artifacts before collection."
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,5,0,10"/>

                    <DataGrid AutoGenerateColumns="False" Height="160"
                              BorderBrush="{DynamicResource BorderBrushGray}" BorderThickness="1">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Width="30"/>
                            <DataGridTextColumn Header="Artifact" Width="180"/>
                            <DataGridTextColumn Header="Description" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- Discovery Results -->
            <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6"
                    BorderBrush="{DynamicResource BorderBrushGray}" BorderThickness="1" Padding="15">
                <Grid>
                <TextBlock Text="Discovery Results" FontWeight="Bold" FontSize="14"
                           Foreground="{DynamicResource TextDarkBrush}" Margin="0,0,0,10"/>
                <DataGrid AutoGenerateColumns="False" Height="180"
                          BorderBrush="{DynamicResource BorderBrushGray}" BorderThickness="1">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="" Width="30"/>
                        <DataGridTextColumn Header="Artifact" Width="150"/>
                        <DataGridTextColumn Header="Path" Width="250"/>
                        <DataGridTextColumn Header="Available" Width="80"/>
                        <DataGridTextColumn Header="Last Record" Width="130"/>
                        <DataGridTextColumn Header="First Record" Width="130"/>
                        <DataGridTemplateColumn Header="Action" Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="✖" Foreground="Red" Background="Transparent" BorderThickness="0" Width="25" Height="25"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                </Grid>
            </Border>

            <!-- Metrics Section -->
            <Grid HorizontalAlignment="Stretch" Margin="0,5,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6"
                        BorderBrush="{DynamicResource BorderBrushGray}" BorderThickness="1"
                        Padding="10" Margin="5">
                    <StackPanel>
                        <TextBlock Text="Discovery Metrics" FontWeight="Bold"
                                   Foreground="{DynamicResource TextDarkBrush}"/>
                        <TextBlock Text="Artifacts Detected: 8 / 12" Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock Text="Total Size: 3.4 GB" Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock Text="Scan Duration: 00:01:12" Foreground="{DynamicResource TextMutedBrush}"/>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6"
                        BorderBrush="{DynamicResource BorderBrushGray}" BorderThickness="1"
                        Padding="10" Margin="5">
                    <StackPanel>
                        <TextBlock Text="Target Details" FontWeight="Bold"
                                   Foreground="{DynamicResource TextDarkBrush}"/>
                        <TextBlock Text="IP Address: 192.168.1.45" Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock Text="Computer Name: DFIR-Workstation01" Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock Text="Make / Model: Dell Precision 5570" Foreground="{DynamicResource TextMutedBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>

        <!-- Navigation -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Back" Width="100" Margin="5" Click="Back_Click"/>
            <Button Content="Next" Width="100" Margin="5"
                    Background="{DynamicResource PrimaryBrush}" Foreground="White"
                    Click="Next_Click"/>
        </StackPanel>
    </Grid>
</Page>
