<Page x:Class="RemiFetchFrame.Views.TargetedCollections.ByUserAccounts.ByUserAccountsWizard2"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Targeted Collections - Preserve User Accounts (Step 2)"
      Background="{DynamicResource AppBackgroundBrush}">

    <Grid Margin="20" >
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- Progress Header -->
        <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6" Padding="12"
                BorderBrush="{DynamicResource BorderBrushGray}" BorderThickness="1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" >
                <TextBlock Text="1. Select Target Method" Foreground="{DynamicResource TextMutedBrush}" />
                <TextBlock Text="→" Foreground="{DynamicResource TextMutedBrush}" Margin="10,0"/>
                <TextBlock Text="2. Choose User Accounts" Foreground="{DynamicResource PrimaryBrush}" FontWeight="Bold"/>
                <TextBlock Text="→" Foreground="{DynamicResource TextMutedBrush}" Margin="10,0"/>
                <TextBlock Text="3. Collect &amp; Export" Foreground="{DynamicResource TextMutedBrush}" />
            </StackPanel>
        </Border>

        <!-- Main Section -->
        <Grid Grid.Row="1" Margin="0,20,0,20" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel -->
            <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6" BorderBrush="{DynamicResource BorderBrushGray}"
                    BorderThickness="1" Padding="15" Margin="0,0,20,0">
                <StackPanel>
                    <TextBlock Text="Detected User Accounts"
                               FontWeight="Bold" FontSize="14"
                               Foreground="{DynamicResource TextDarkBrush}" Margin="0,0,0,10"/>

                    <DataGrid AutoGenerateColumns="False" Height="260" HeadersVisibility="Column"
                              BorderBrush="{DynamicResource BorderBrushGray}" BorderThickness="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="User Name" Width="*" Binding="{Binding UserName}"/>
                            <DataGridTextColumn Header="Profile Path" Width="2*" Binding="{Binding Path}"/>
                            <DataGridTextColumn Header="Status" Width="Auto" Binding="{Binding Status}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="Add User" Width="100" Margin="5"/>
                        <Button Content="Remove Selected" Width="130" Margin="5"/>
                        <Button Content="Rescan" Width="90" Margin="5"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Right Panel -->
            <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6" Padding="15"
                    BorderBrush="{DynamicResource BorderBrushGray}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Account Options" FontWeight="Bold" FontSize="14"
                               Foreground="{DynamicResource TextDarkBrush}" Margin="0,0,0,10"/>

                    <CheckBox Content="Include Hidden Profiles" Margin="5,2"/>
                    <CheckBox Content="Include Disabled Accounts" Margin="5,2"/>
                    <CheckBox Content="Collect Only Active Sessions" Margin="5,2"/>
                    <CheckBox Content="Preserve NTUSER.DAT / SAM / SECURITY" Margin="5,2" />

                    <Separator Margin="10"/>

                    <TextBlock Text="Summary" FontWeight="Bold" FontSize="13"
                               Foreground="{DynamicResource TextDarkBrush}" Margin="0,0,0,10"/>
                    <TextBlock Text="Accounts Selected: 4" Foreground="{DynamicResource TextMutedBrush}"/>
                    <TextBlock Text="Profiles Found: 6" Foreground="{DynamicResource TextMutedBrush}"/>
                    <TextBlock Text="Estimated Size: 1.2 GB" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,10"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Navigation -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Back" Width="100" Margin="5" Click="Back_Click"/>
            <Button Content="Next" Width="100" Margin="5"
                    Background="{DynamicResource PrimaryBrush}" Foreground="White"
                    Click="Next_Click"/>
        </StackPanel>
    </Grid>
</Page>
