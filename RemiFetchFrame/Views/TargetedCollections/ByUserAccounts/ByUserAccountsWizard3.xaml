<Page x:Class="RemiFetchFrame.Views.TargetedCollections.ByUserAccounts.ByUserAccountsWizard3"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Targeted Collections - Preserve User Accounts (Step 3)"
      Background="{DynamicResource AppBackgroundBrush}">

    <Grid Margin="20" >
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Progress Header -->
        <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6" Padding="12"
                BorderBrush="{DynamicResource BorderBrushGray}" BorderThickness="1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" >
                <TextBlock Text="1. Select Target Method" Foreground="{DynamicResource TextMutedBrush}" />
                <TextBlock Text="→" Foreground="{DynamicResource TextMutedBrush}" Margin="10,0"/>
                <TextBlock Text="2. Choose User Accounts" Foreground="{DynamicResource TextMutedBrush}" />
                <TextBlock Text="→" Foreground="{DynamicResource TextMutedBrush}" Margin="10,0"/>
                <TextBlock Text="3. Preserve &amp; Export" Foreground="{DynamicResource PrimaryBrush}" FontWeight="Bold"/>
            </StackPanel>
        </Border>

        <!-- Main Section -->
        <Grid Grid.Row="1" Margin="0,20,0,20" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <!-- Left: Progress and Logs -->
            <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6"
                    BorderBrush="{DynamicResource BorderBrushGray}" BorderThickness="1"
                    Padding="15" Margin="0,0,20,0">
                <StackPanel>
                    <TextBlock Text="Preservation Progress"
                               FontWeight="Bold" FontSize="14"
                               Foreground="{DynamicResource TextDarkBrush}" Margin="0,0,0,10"/>
                    <ProgressBar Height="20" Minimum="0" Maximum="100" Value="70" Margin="0,0,0,10"/>
                    <ListBox Height="200">
                        <ListBoxItem>Account 'Alice' - Completed (Success)</ListBoxItem>
                        <ListBoxItem>Account 'Bob' - In Progress...</ListBoxItem>
                        <ListBoxItem>Account 'Charlie' - Pending</ListBoxItem>
                    </ListBox>
                </StackPanel>
            </Border>

            <!-- Right: Summary -->
            <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6"
                    BorderBrush="{DynamicResource BorderBrushGray}" BorderThickness="1" Padding="15">
                <StackPanel>
                    <TextBlock Text="Preservation Summary"
                               FontWeight="Bold" FontSize="14"
                               Foreground="{DynamicResource TextDarkBrush}" Margin="0,0,0,10"/>
                    <TextBlock Text="Accounts Processed: 3 / 6" Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBlock Text="Artifacts Collected: 180" Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBlock Text="Data Size: 2.4 GB" Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBlock Text="Elapsed Time: 00:09:32" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,10"/>
                    <TextBlock Text="Export Directory:" FontWeight="Bold" Foreground="{DynamicResource TextDarkBrush}" />
                    <TextBlock Text="D:\\Evidence\\UserProfiles\\" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,10"/>
                    <Button Content="Open Folder" Width="120" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Navigation -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Back" Width="100" Margin="5" Click="Back_Click"/>
            <Button Content="Finish" Width="100" Margin="5"
                    Background="{DynamicResource PrimaryBrush}" Foreground="White"
                    Click="Finish_Click"/>
        </StackPanel>
    </Grid>
</Page>
