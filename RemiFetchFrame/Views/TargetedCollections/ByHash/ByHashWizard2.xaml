<Page x:Class="RemiFetchFrame.Views.TargetedCollections.ByHash.ByHashWizard2"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Targeted Collections - By Hash (Step 2)"
      Background="{DynamicResource AppBackgroundBrush}">

    <Grid Margin="20" >
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Progress Header -->
        <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6" Padding="12"
                BorderBrush="{DynamicResource BorderBrushGray}" BorderThickness="1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" >
                <TextBlock Text="1. Select Target Method" Foreground="{DynamicResource TextMutedBrush}" />
                <TextBlock Text="→" Foreground="{DynamicResource TextMutedBrush}" Margin="10,0"/>
                <TextBlock Text="2. Choose Filters" Foreground="{DynamicResource PrimaryBrush}" FontWeight="Bold"/>
                <TextBlock Text="→" Foreground="{DynamicResource TextMutedBrush}" Margin="10,0"/>
                <TextBlock Text="3. Collect &amp; Export" Foreground="{DynamicResource TextMutedBrush}" />
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="0,20,0,20" >

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <!-- Left Panel -->
            <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6" BorderBrush="{DynamicResource BorderBrushGray}"
                    BorderThickness="1" Padding="15" Margin="0,0,20,0">
                <StackPanel>
                    <TextBlock Text="Import or Paste Hash List" FontWeight="Bold" FontSize="14"
                               Foreground="{DynamicResource TextDarkBrush}" Margin="0,0,0,10"/>
                    <TextBox AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="150"
                             BorderBrush="{DynamicResource BorderBrushGray}" BorderThickness="1"
                             Foreground="{DynamicResource TextDarkBrush}" Background="{DynamicResource AppBackgroundBrush}"
                             ToolTip="Paste or import hash values here..."/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Content="Import File" Width="110" Margin="5"/>
                        <Button Content="Clear" Width="80" Margin="5"/>
                    </StackPanel>

                    <Separator Margin="10"/>

                    <TextBlock Text="Select Sources to Scan"
                               FontWeight="Bold" FontSize="14"
                               Foreground="{DynamicResource TextDarkBrush}" Margin="0,0,0,10"/>
                    <StackPanel>
                        <CheckBox Content="All Mounted Drives" Margin="5,2"/>
                        <CheckBox Content="USB Devices" Margin="5,2"/>
                        <CheckBox Content="Network Shares" Margin="5,2"/>
                        <CheckBox Content="Cloud Storage" Margin="5,2"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Right Panel -->
            <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6" Padding="15"
                    BorderBrush="{DynamicResource BorderBrushGray}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Filter Summary" FontWeight="Bold" FontSize="14"
                               Foreground="{DynamicResource TextDarkBrush}" Margin="0,0,0,10"/>
                    <TextBlock Text="Loaded Hashes: 250" Foreground="{DynamicResource TextMutedBrush}"/>
                    <TextBlock Text="Sources Selected: 3" Foreground="{DynamicResource TextMutedBrush}"/>
                    <TextBlock Text="Expected Scan Duration: ~3m 40s" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,10"/>
                    <Button Content="Validate Hashes" Width="130"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Navigation -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Back" Width="100" Margin="5" Click="Back_Click"/>
            <Button Content="Next" Width="100" Margin="5" 
                    Background="{DynamicResource PrimaryBrush}" Foreground="White"
                    Click="Next_Click"/>
        </StackPanel>
    </Grid>
</Page>
