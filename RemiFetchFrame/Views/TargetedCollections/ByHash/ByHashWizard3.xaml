<Page x:Class="RemiFetchFrame.Views.TargetedCollections.ByHash.ByHashWizard3"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Targeted Collections - By Hash (Step 3)"
      Background="{DynamicResource AppBackgroundBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- Progress Header -->
        <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6" Padding="12"
                BorderBrush="{DynamicResource BorderBrushGray}" BorderThickness="1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" >
                <TextBlock Text="1. Select Target Method" Foreground="{DynamicResource TextMutedBrush}" />
                <TextBlock Text="→" Foreground="{DynamicResource TextMutedBrush}" Margin="10,0"/>
                <TextBlock Text="2. Choose Filters" Foreground="{DynamicResource TextMutedBrush}" />
                <TextBlock Text="→" Foreground="{DynamicResource TextMutedBrush}" Margin="10,0"/>
                <TextBlock Text="3. Collect &amp; Export" Foreground="{DynamicResource PrimaryBrush}" FontWeight="Bold"/>
            </StackPanel>
        </Border>

        <!-- Main Section -->
        <Grid Grid.Row="1" Margin="0,20,0,20" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Match Results -->
            <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6" BorderBrush="{DynamicResource BorderBrushGray}"
                    BorderThickness="1" Padding="15" Margin="0,0,20,0">
                <StackPanel>
                    <TextBlock Text="Matching Files Found"
                               FontWeight="Bold" FontSize="14"
                               Foreground="{DynamicResource TextDarkBrush}" Margin="0,0,0,10"/>
                    <DataGrid AutoGenerateColumns="False" Height="240" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="File Name" Width="*" Binding="{Binding FileName}"/>
                            <DataGridTextColumn Header="Path" Width="2*" Binding="{Binding FilePath}"/>
                            <DataGridTextColumn Header="Hash" Width="*" Binding="{Binding HashValue}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <ProgressBar Height="20" Minimum="0" Maximum="100" Value="55" Margin="0,10,0,10"/>
                    <TextBlock Text="Scanning... 55% complete" Foreground="{DynamicResource TextMutedBrush}"/>
                </StackPanel>
            </Border>

            <!-- Right: Export Summary -->
            <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6" Padding="15"
                    BorderBrush="{DynamicResource BorderBrushGray}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Metrics Summary" FontWeight="Bold" FontSize="14"
                               Foreground="{DynamicResource TextDarkBrush}" Margin="0,0,0,10"/>
                    <TextBlock Text="Matches Found: 27" Foreground="{DynamicResource TextMutedBrush}"/>
                    <TextBlock Text="Total Data Size: 3.6 GB" Foreground="{DynamicResource TextMutedBrush}"/>
                    <TextBlock Text="Elapsed Time: 00:03:42" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,10"/>
                    <TextBlock Text="Export Folder: D:\\Evidence\\Hash_Matches" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,10"/>
                    <Button Content="Export Results" Width="130" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Navigation -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Back" Width="100" Margin="5" Click="Back_Click"/>
            <Button Content="Finish" Width="100" Margin="5"
                    Background="{DynamicResource PrimaryBrush}" Foreground="White"
                    Click="Finish_Click"/>
        </StackPanel>
    </Grid>
</Page>
