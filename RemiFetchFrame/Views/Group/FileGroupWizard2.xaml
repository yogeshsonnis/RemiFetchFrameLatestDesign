<UserControl x:Class="RemiFetchFrame.Views.Group.FileGroupWizard2"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RemiFetchFrame.Views.Group"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Border Background="White" CornerRadius="12" 
                BorderBrush="#D1D5DB" BorderThickness="1">
            <DockPanel>

                <!-- Header -->
                <Border Background="#F9FAFB" BorderBrush="#D1D5DB" BorderThickness="0,0,0,1"
                        DockPanel.Dock="Top" Padding="10,6">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Ellipse Width="28" Height="28" Fill="#2563EB"/>
                        <TextBlock Text="Select File Groups" Margin="8,0"/>
                        <Rectangle Width="60" Height="2" Fill="#D1D5DB" Margin="12,0"/>
                        <Ellipse Width="28" Height="28" Fill="#1565C0"/>
                        <TextBlock Text="Collect &amp; Export" Margin="8,0" Foreground="#1565C0"/>
                    </StackPanel>
                </Border>

                <!-- Body -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#F9FAFB">
                    <StackPanel Margin="20" Orientation="Vertical" >

                        <!-- Collection Results Table -->
                        <GroupBox Header="Collection Results" Margin="0,0,0,8">
                            <StackPanel>
                                <DataGrid AutoGenerateColumns="False" HeadersVisibility="Column"
                                          Height="300" CanUserAddRows="False">
                                    <DataGrid.Columns>
                                        <DataGridCheckBoxColumn Header="Select" Width="Auto"/>
                                        <DataGridTextColumn Header="Filename" Binding="{Binding Filename}" Width="*"/>
                                        <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="2*"/>
                                        <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="*"/>
                                        <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="*"/>
                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </GroupBox>

                        <!-- Progress & Status -->
                        <GroupBox Header="Collection &amp; Export Status" Margin="0,0,0,8">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,6">
                                    <Button Content="Start" Width="100" Style="{StaticResource RoundedButton}" Height="30"
                                            Background="#2563EB" Foreground="White" FontWeight="Normal"/>
                                </StackPanel>
                                <TextBlock Text="Collecting user files and preparing export package..."
                                           Margin="0,0,0,6" Foreground="#374151"/>
                                <ProgressBar Height="12" Value="65" Margin="0,0,0,4"
                                             Foreground="#2563EB" Background="#E5E7EB"/>
                                <DockPanel>
                                    <TextBlock Text="65% Completed" DockPanel.Dock="Left" Foreground="#374151"/>
                                    <TextBlock Text="Estimated Time: 00:01:32" DockPanel.Dock="Right" Foreground="#374151"/>
                                </DockPanel>
                            </StackPanel>
                        </GroupBox>

                        <!-- Bottom Summary Cards -->
                        <UniformGrid Columns="3" Rows="1">
                            <!-- Export Summary -->
                            <Border BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6"
                                    Background="White" Margin="4" Padding="8">
                                <StackPanel>
                                    <TextBlock Text="Export Summary" FontWeight="Bold" Margin="0,0,0,6"/>
                                    <TextBlock Text="Total Files Collected: 235"/>
                                    <TextBlock Text="Total Data Size: 4.3 GB"/>
                                    <TextBlock Text="Export Format: Forensic ZIP"/>
                                    <TextBlock Text="Location: E:/Case123/Exports/"/>
                                </StackPanel>
                            </Border>

                            <!-- Chain of Custody -->
                            <Border BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6"
                                    Background="White" Margin="4" Padding="8">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal"  Margin="0,0,0,4">
                                        <TextBlock Text="Chain of Custody" FontWeight="Bold"/>
                                        <ToggleButton Width="40" Style="{StaticResource SwitchToggleStyle}" Height="20" Background="#D1D5DB"
                                                      BorderBrush="#D1D5DB" BorderThickness="1" Margin="10,0,0,0"/>
                                    </StackPanel>
                                    <TextBox Margin="0,2,0,4" Height="24" Text="Custodian"/>
                                    <TextBox Margin="0,2,0,4" Height="24" Text="Agency"/>
                                    <TextBox Margin="0,2,0,4" Height="24" Text="Examiner"/>
                                </StackPanel>
                            </Border>

                            <!-- Metrics -->
                            <Border BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6"
                                    Background="White" Margin="4" Padding="8">
                                <StackPanel>
                                    <TextBlock Text="Metrics" FontWeight="Bold" Margin="0,0,0,6"/>
                                    <TextBlock Text="Average File Size: 56 KB"/>
                                    <TextBlock Text="Processing Rate: 42 files/sec"/>
                                    <TextBlock Text="Errors Detected: 0"/>
                                    <TextBlock Text="Duration: 2m 31s"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>

</UserControl>
