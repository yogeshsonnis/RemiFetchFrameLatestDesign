<UserControl x:Class="Remi.Fetch.Views.Group.FileGroupWizard1"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Remi.Fetch.Views.Group"
             mc:Ignorable="d" 
             >
    <Grid>
        <Border Background="White" CornerRadius="8"
                BorderBrush="#D1D5DB" BorderThickness="1" 
                Effect="{DynamicResource DropShadowEffect}">
            <DockPanel>
                <!-- Header -->
                <Border Background="#F9FAFB" BorderBrush="#D1D5DB" BorderThickness="0,0,0,1" DockPanel.Dock="Top" Padding="10,6">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Ellipse Width="28" Height="28" Fill="#2563EB"/>
                        <TextBlock Text="Select File Groups" Foreground="#2563EB" Margin="8,0"/>
                        <Rectangle Width="60" Height="2" Fill="#D1D5DB" Margin="12,0"/>
                        <Ellipse Width="28" Height="28" Fill="#E5E7EB"/>
                        <TextBlock Text="Collect &amp; Export" Margin="8,0"/>
                    </StackPanel>
                </Border>

                <!-- Body -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#F9FAFB">
                    <StackPanel Margin="20" Orientation="Vertical" >

                        <!-- File Categories -->
                        <GroupBox Header="Select File Categories" Margin="0,0,0,16">
                            <StackPanel Margin="4,8,4,8">
                                <Expander Header="Documents &amp; Office Files" IsExpanded="False">
                                    <StackPanel Margin="12,4,0,4">
                                        <CheckBox Content=".doc, .docx, .xls, .xlsx, .ppt, .pptx, .pdf, .csv, .txt, .rtf, .odt, .ods, .odp"/>
                                    </StackPanel>
                                </Expander>

                                <Expander Header="Mobile &amp; iTunes Backups" IsExpanded="False">
                                    <StackPanel Margin="12,4,0,4">
                                        <CheckBox Content=".ipa, .plist, .db, .sqlite, .bak, .tar, .gz, .zip, .json, .xml"/>
                                    </StackPanel>
                                </Expander>

                                <Expander Header="User Profiles &amp; Accounts" IsExpanded="False">
                                    <StackPanel Margin="12,4,0,4">
                                        <CheckBox Content="AppData, Desktop, Documents, Downloads, NTUSER.DAT, SAM, SECURITY, SOFTWARE, SYSTEM"/>
                                    </StackPanel>
                                </Expander>

                                <Expander Header="Incident Response" IsExpanded="False">
                                    <StackPanel Margin="12,4,0,4">
                                        <CheckBox Content="Windows Registry Targets: NTUSER.DAT, USRCLASS.DAT, SAM, SECURITY, SOFTWARE, SYSTEM"/>
                                    </StackPanel>
                                </Expander>

                                <Expander Header="Communications" IsExpanded="False">
                                    <StackPanel Margin="12,4,0,4">
                                        <CheckBox Content=".pst, .ost, .nst, .msg, .eml, .mbox, .msf, .dbx, .oeaccount"/>
                                    </StackPanel>
                                </Expander>

                                <Expander Header="Media Files" IsExpanded="False">
                                    <StackPanel Margin="12,4,0,4">
                                        <CheckBox Content=".jpg, .jpeg, .png, .gif, .bmp, .tiff, .mp3, .wav, .mp4, .avi, .mov, .mkv, .flac"/>
                                    </StackPanel>
                                </Expander>

                                <Expander Header="Web Data &amp; Cookies" IsExpanded="False">
                                    <StackPanel Margin="12,4,0,4">
                                        <CheckBox Content=".sqlite, .json, .xml, .dat, .log, Cookies, Cache, History, Login Data, Bookmarks"/>
                                    </StackPanel>
                                </Expander>

                                <Expander Header="Databases" IsExpanded="False">
                                    <StackPanel Margin="12,4,0,4">
                                        <CheckBox Content=".sql, .sqlite, .db, .mdb, .accdb, .frm, .ibd, .ndf, .mdf, .ldf"/>
                                    </StackPanel>
                                </Expander>

                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                                    
                                </StackPanel>
                            </StackPanel>
                            
                        </GroupBox>

                        <!-- Sources and Date Range -->
                        <StackPanel Orientation="Horizontal" Margin="16">
                            <!-- Sources -->
                            <GroupBox Header="Select Sources to Search" Width="Auto" Margin="0,0,8,0">
                                <StackPanel Margin="8,6,8,6">
                                    <CheckBox Content="All Mounted Drives"/>
                                    <CheckBox Content="Archives (ZIP, RAR, 7Z, TAR, ISO)"/>
                                    <CheckBox Content="Virtual Machines"/>
                                    <CheckBox Content="All Mounted USB Drives"/>
                                    <CheckBox Content="Cloud Drives"/>
                                    <CheckBox Content="Network Shares"/>
                                </StackPanel>
                            </GroupBox>

                            <!-- Date Range -->
                            <GroupBox Header="Date Range Filter" Width="Auto" Margin="8,0,0,0">
                                <StackPanel Margin="8,6,8,6">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="Start:" Width="60" VerticalAlignment="Center"/>
                                        <DatePicker Width="160"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="End:" Width="60" VerticalAlignment="Center"/>
                                        <DatePicker Width="160"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="6">
                                        <TextBlock Text="Filter" FontSize="11" Foreground="#4B5563" VerticalAlignment="Center" />
                                        <ToggleButton Width="40" Style="{StaticResource SwitchToggleStyle}" Height="20" Background="#D1D5DB" Margin="10,0,0,0"
                                                      BorderBrush="#D1D5DB" BorderThickness="1"/>
                                    </StackPanel>
                                    
                                </StackPanel>
                                
                            </GroupBox>
                            
                        </StackPanel>
                        <!--<Button x:Name="BtnNext"
Content="Next →" HorizontalAlignment="Right"
Width="120"
Style="{StaticResource RoundedButton}"    
Height="32"
Background="#1565c0"
Foreground="White"
BorderThickness="0"
Click="OnNext"/>-->
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>

</UserControl>
