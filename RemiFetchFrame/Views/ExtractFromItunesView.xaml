<Window x:Class="Remi.Fetch.Views.ExtractFromItunesView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Remi.Fetch.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ExtractFromItunesView">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Text="Extract from iTunes Backup"
                FontSize="20"
                FontWeight="Bold"
                Foreground="#1A1A1A"
                Margin="0,0,0,10"/>

        <!-- Backup List -->
        <GroupBox Header="Imported Backups" Grid.Row="1" FontWeight="SemiBold" Margin="0,10,0,10">
            <Grid>
                <DataGrid x:Name="BackupGrid"
                       AutoGenerateColumns="False"
                       IsReadOnly="True"
                       SelectionMode="Single"
                       HeadersVisibility="Column"
                       Margin="0,10,0,0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="File Name" Binding="{Binding FileName}" Width="3*"/>
                        <DataGridTextColumn Header="Size (MB)" Binding="{Binding FileSizeMB}" Width="*"/>
                        <DataGridTextColumn Header="Hash" Binding="{Binding FileHash}" Width="3*"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="1.5*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </GroupBox>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="ImportBtn" Content="Import Backup" Width="150" Height="35" Margin="0,0,10,0" Click="ImportBtn_Click"/>
            <Button x:Name="ExportBtn" Content="Export Results" Width="150" Height="35" IsEnabled="False" Click="ExportBtn_Click"/>
        </StackPanel>

        <!-- Local Progress Area -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,10,0,0">
            <TextBlock x:Name="LocalStatusText" Text="Ready" Foreground="#555" FontSize="12" VerticalAlignment="Center"/>
            <ProgressBar x:Name="LocalProgressBar" Width="180" Height="10" Margin="15,0,0,0" Visibility="Collapsed"/>
        </StackPanel>
    </Grid>
</Window>
