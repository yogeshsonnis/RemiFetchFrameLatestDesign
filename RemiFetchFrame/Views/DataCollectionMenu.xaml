<UserControl x:Class="RemiFetchFrame.Views.DataCollectionMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RemiFetchFrame.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Brand / App header -->
        <StackPanel Orientation="Horizontal"
                 Height="60" Background="#1565C0"
                 VerticalAlignment="Center">
            <TextBlock Text="Fetch &amp; Retrieve"
                    Foreground="White"
                    FontWeight="Bold"
                    FontSize="16"
                    Margin="20,0,0,0"
                    VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Menu buttons -->
        <StackPanel Grid.Row="1" Margin="0,10">
            <Button x:Name="BtnItunes"
                 Content="📱 Extract from iTunes Backup"
                 Margin="10,4"
                 Height="36"
                 HorizontalContentAlignment="Left"
                 
                 Background="Transparent"
                 Foreground="#333"
                 BorderBrush="Transparent"
                 Cursor="Hand"/> <!--Click="BtnItunes_Click"-->
            <Button x:Name="BtnReports"
                 Content="📑 Reports"
                 Margin="10,4"
                 Height="36"
                 HorizontalContentAlignment="Left"
                 
                 Background="Transparent"
                 Foreground="#333"
                 BorderBrush="Transparent"
                 Cursor="Hand"/> <!--Click="BtnReports_Click"-->
            <Button x:Name="BtnExport"
                 Content="📦 Export Case"
                 Margin="10,4"
                 Height="36"
                 HorizontalContentAlignment="Left"
                
                 Background="Transparent"
                 Foreground="#333"
                 BorderBrush="Transparent"
                 Cursor="Hand"/> <!--Click="BtnExport_Click"-->
            <Button x:Name="BtnSettings"
                 Content="⚙️ Settings"
                 Margin="10,4"
                 Height="36"
                 HorizontalContentAlignment="Left"
                 
                 Background="Transparent"
                 Foreground="#333"
                 BorderBrush="Transparent"
                 Cursor="Hand"/> <!--Click="BtnSettings_Click"-->
        </StackPanel>

        <!-- Footer -->
        <StackPanel Grid.Row="2" Margin="10,0,0,10">
            <TextBlock Text="v1.0"
                    Foreground="#999"
                    FontSize="11"
                    HorizontalAlignment="Left"/>
        </StackPanel>
    </Grid>
</UserControl>
