    <Window.Resources>

        <Style x:Key="RoundedRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="Background" Value="#E0E0E0"/>
            <!--<Setter Property="BorderBrush" Value="#FF005A9E"/>-->
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="6,6,0,0">

                            <ContentPresenter
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        RecognizesAccessKey="True"/>
                        </Border>

                        <!-- Button States -->
                        <ControlTemplate.Triggers>

                            <!-- Hover -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border"
                                Property="Background"
                                Value="#1567c0"/>
                                <Setter  
                                Property="Foreground"
                                Value="White"/>
                            </Trigger>



                            <!-- Disabled -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border"
                                Property="Opacity"
                                Value="0.5"/>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <SolidColorBrush x:Key="TextBoxBorderBrush" Color="#CCCCCC" />
        <SolidColorBrush x:Key="TextBoxBorderFocusedBrush" Color="#1E6BD6" />
        <SolidColorBrush x:Key="TextBoxBackground" Color="White" />

        <SolidColorBrush x:Key="TextBoxPlaceholderBrush" Color="#88000000"/>

        <Style x:Key="RoundedPlaceholderTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="45"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="BorderBrush" Value="{StaticResource TextBoxBorderBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Foreground" Value="#555"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <!-- Base surface -->
                            <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"/>

                            <!-- Real text host -->
                            <ScrollViewer x:Name="PART_ContentHost"
                                  Margin="{TemplateBinding Padding}"
                                  VerticalAlignment="Center"/>

                            <!-- Placeholder layered above content -->
                            <TextBlock x:Name="PlaceholderText"
                                       Padding="8,5"
                               Margin="{TemplateBinding Padding}"
                               Text="{TemplateBinding Tag}"
                               Foreground="Gray"
                             
                               IsHitTestVisible="False"
                               VerticalAlignment="Center"
                               TextTrimming="None"
                               TextWrapping="NoWrap"
                               Visibility="Collapsed"/>
                        </Grid>

                        <!-- Triggers -->
                        <ControlTemplate.Triggers>
                            <!-- Focus border color -->
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush"
                                Value="Black"/>

                            </Trigger>

                            <!-- Disabled -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.6"/>
                            </Trigger>

                            <!-- Show placeholder when empty -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Text" Value=""/>
                                    <Condition Property="IsKeyboardFocused" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible"/>
                            </MultiTrigger>

                            <!-- Also show when empty AND focused (optional: comment out to hide during focus) -->
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible"/>
                            </Trigger>

                            <!-- Hide placeholder once user types -->
                            <Trigger Property="Text" Value="{x:Null}">
                                <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>



    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Background="#1567c0" Height="50">
            <StackPanel Orientation="Horizontal" Margin="24,0,0,0" VerticalAlignment="Center">
                 <Menu Background="Transparent" Foreground="White" FontSize="16">
                    <MenuItem Header="File">
                        <MenuItem Header="New" Click="NewCase_Clicked" Foreground="DarkGray" FontSize="16"/>
                        <MenuItem Header="Open Case" Click="OpenCase_Clicked" Foreground="DarkGray" FontSize="16"/>
                        <MenuItem Header="Quit" Click="QuiteButton_Clicked" Foreground="DarkGray" FontSize="16"/>


                    </MenuItem>
                </Menu>
            </StackPanel>
            <TextBlock Text="V1.0.0" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="White" Margin="0,0,20,0"/>
        </DockPanel>
        <Grid Background="White" Grid.Row="1">
            <Border Style="{StaticResource CardStyle}" Background="Transparent" Margin="40">
                <Grid >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="0"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                  
                        <Grid Grid.Row="1">
                            <Grid x:Name="NewCaseView" >
                                <Border BorderBrush="{StaticResource TextBoxBorderBrush}" Background="Transparent" Padding="24" CornerRadius="8" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    
                                   
                                        <Grid Width="500" Height="360" Margin="0,0,5,0">
                                            <StackPanel>
                                                <TextBox Style="{StaticResource RoundedPlaceholderTextBox}" Tag="Case Name" Margin="0,20,0,12" x:Name="casenameTextbox" />
                                                <TextBox Style="{StaticResource RoundedPlaceholderTextBox}" Tag="Matter Number" Margin="0,0,0,12" x:Name="matterNumberTextbox"/>
                                                <TextBox Style="{StaticResource RoundedPlaceholderTextBox}" Tag="Examiner" Margin="0,0,0,12" x:Name="examinerTextbox"/>
                                                <TextBlock Text="Choose Save Location:" Foreground="#555" FontWeight="SemiBold" FontSize="18"/>
                                                <TextBox Style="{StaticResource RoundedPlaceholderTextBox}" Tag="Enter save location (e.g. C:\Cases\Output)" Margin="0,7,0,12"  x:Name="SaveLocationTextBox"/>
                                               
                                                <Button Content="Create Case" Style="{StaticResource RoundedButton}" Width="Auto" Click="Add_Click"/>
                                            </StackPanel>
                                        </Grid>

                                  
                                </Border>
                            </Grid>
                            <Grid x:Name="OpenCaseView" Visibility="Collapsed">

                                <DataGrid x:Name="CaseDataGrid" ItemsSource="{Binding Cases}"
                           SelectionChanged="DataGrid_SelectionChanged"
                           Margin="20"
                           VerticalAlignment="Top" 
                           Height="Auto"
                           AutoGenerateColumns="False"
                           IsReadOnly="True"
                           CanUserAddRows="False"
                           RowHeight="34"
                           ColumnHeaderHeight="34"
                           SelectionMode="Single"
                           SelectionUnit="FullRow"
                           HeadersVisibility="Column"       
                           RowHeaderWidth="0"
                           VerticalGridLinesBrush="#E0E0E0"
                           HorizontalGridLinesBrush="#E0E0E0"
                           BorderBrush="#D0D0D0"     
                           BorderThickness="1" 
                          >

                                    <!-- Resources that disable highlight -->
                                    <DataGrid.Resources>


                                        <Style TargetType="DataGridCell">
                                            <Setter Property="Focusable" Value="False"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>

                                            <!-- This controls vertical centering -->
                                            <Setter Property="VerticalContentAlignment" Value="Center"/>

                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="DataGridCell">
                                                        <Border Background="{TemplateBinding Background}"
                                                     BorderBrush="{TemplateBinding BorderBrush}"
                                                     BorderThickness="{TemplateBinding BorderThickness}"
                                                     Padding="0">
                                                            <ContentPresenter Margin="3,0,0,0"
                                                     VerticalAlignment="Center"
                                                     HorizontalAlignment="Left"
                                                     SnapsToDevicePixels="True"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>

                                            <Style.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="#1567c0"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>

                                        <Style TargetType="DataGridRow">
                                            <Style.Triggers>

                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#1567c0"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>

                                        <!-- Bold Header -->
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </Style>

                                    </DataGrid.Resources>

                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Case Name" Binding="{Binding CaseName}" Width="*"/>
                                        <DataGridTextColumn Header="Matter Number" Binding="{Binding MatterNumber}" Width="*"/>
                                        <DataGridTextColumn Header="Save Location" Binding="{Binding SaveLocation}" Width="*"/>
                                        <DataGridTextColumn Header="Created Date" Binding="{Binding CreatedDate, StringFormat=\{0:yyyy-MM-dd\}}" Width="*"/>
                                        <DataGridTextColumn Header="Total Devices" Binding="{Binding TotalDevices}" Width="*"/>
                                    </DataGrid.Columns>

                                </DataGrid>


                            </Grid>

                        </Grid>
                   
                </Grid>

            </Border>

        </Grid>
        <Border Grid.Row="2" Background="#1567c0" Height="30">
            <TextBlock Text="Status: Ready | No active jobs"
       Foreground="White"
       VerticalAlignment="Center"
       HorizontalAlignment="Right"
       FontSize="13" Margin="0,0,16,0"/>
        </Border>
    </Grid>
   
</Window>
