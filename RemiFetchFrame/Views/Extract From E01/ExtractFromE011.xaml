<UserControl x:Class="Remi.Fetch.Views.Extract_From_E01.ExtractFromE011"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Remi.Fetch.Views.Extract_From_E01"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="0">
        <Border Background="White" CornerRadius="13" 
                Margin="0" 
                SnapsToDevicePixels="True" 
                BorderBrush="#E5E7EB"
BorderThickness="1"
Effect="{StaticResource CardShadow}"> <!--Effect="{DynamicResource {x:Static SystemParameters.DropShadowEffectKey}}"-->
            <DockPanel>
                <!-- Wizard Header -->
                <Border Background="#F9FAFB" BorderBrush="#D1D5DB"  CornerRadius="13" BorderThickness="0,0,0,1" DockPanel.Dock="Top" Padding="0,6">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10,0">
                        <Grid Width="28" Height="28">
                            <Ellipse Fill="#1565C0" VerticalAlignment="Center"/>
                            <TextBlock Text="1"
                   Foreground="White"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
                        </Grid>
                       
                        <TextBlock Text="  Select E01 Folder" Foreground="#1565C0" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="14" Margin="6,0"/>
                        
                        <Rectangle Width="60" Height="2" Fill="#D1D5DB" Margin="12,0"/>
                        <Grid Width="28" Height="28">
                            <Ellipse Fill="#E5E7EB"/>
                            <TextBlock Text="2"
                   Foreground="#374151"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="  Choose Data Types" Foreground="#6B7280" FontWeight="Medium" Margin="6,0" VerticalAlignment="Center"/>
                        <Rectangle Width="60" Height="2" Fill="#D1D5DB" Margin="12,0"/>
                        <Grid Width="28" Height="28" VerticalAlignment="Center">
                            <Ellipse Fill="#E5E7EB"/>
                            <TextBlock Text="3"
               Foreground="#374151"
               FontWeight="SemiBold"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="  Extract &amp; Export" VerticalAlignment="Center" Foreground="#6B7280" FontWeight="Medium" Margin="6,0"/>
                    </StackPanel>
                </Border>

                <!-- Main Content -->
                <StackPanel Background="#F9FAFB" Margin="10" Orientation="Vertical" DockPanel.Dock="Top" VerticalAlignment="Stretch">

                    <!-- Import Summary -->
                    <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,10,0,10">
                        <UniformGrid Columns="3" Rows="2" Margin="10,5" HorizontalAlignment="Stretch">
                            <TextBlock Text="Total E01 Sets Imported: 5" FontSize="13" Foreground="#374151"/>
                            <TextBlock Text="Integrity Check: Passed" FontSize="13" Foreground="#16A34A" FontWeight="Bold"/>
                            <TextBlock Text="Duplicates Ignored: 1" FontSize="13" Foreground="#374151"/>
                            <TextBlock Text="Combined Size: 42.6 GB" FontSize="13" Foreground="#374151"/>
                            <TextBlock Text="Files Located: 35,482" FontSize="13" Foreground="#374151"/>
                            <TextBlock Text="Unique Volumes: 3" FontSize="13" Foreground="#374151"/>
                        </UniformGrid>
                    </Border>

                    <!-- Action Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,10">
                        <Button Content="Add Folder..." Background="#1565C0" Foreground="White" Style="{StaticResource RoundedButton}" Height="30" Width="100" FontSize="12" Margin="0,0,6,0"/>
                        <Button Content="Remove Selected" Style="{StaticResource NormalButtonStyle}" Background="#E5E7EB" Foreground="#111827" Width="100" FontSize="12" Margin="0,0,6,0"/>
                        <Button Content="Clear List" Background="#E5E7EB" Foreground="#111827"  Style="{StaticResource NormalButtonStyle}" Width="70" FontSize="12"/>
                    </StackPanel>

                    <!-- Table -->
                    <DataGrid x:Name="MyDataGrid" VerticalAlignment="Top" 
Height="Auto"
AutoGenerateColumns="False"
IsReadOnly="True"
CanUserAddRows="False"
RowHeight="34"
   CellStyle="{StaticResource DataGridCellStyle}"
           RowStyle="{StaticResource DatagridRowStyle}"
           ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
ColumnHeaderHeight="34"
SelectionMode="Single"
SelectionUnit="FullRow"
HeadersVisibility="Column"       
RowHeaderWidth="0"
VerticalGridLinesBrush="#E0E0E0"
HorizontalGridLinesBrush="#E0E0E0"
BorderBrush="#D0D0D0"     
BorderThickness="1" >
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Image Set" Binding="{Binding ImageSet}" Width="150"/>
                            <DataGridTextColumn Header="Source Path" Binding="{Binding SourcePath}" Width="2*"/>
                            <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="*"/>
                            <DataGridTextColumn Header="Volume Count" Binding="{Binding VolumeCount}" Width="130" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Footer --><!--
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="Next →" Background="#1565C0" Foreground="White"  Click="NextButton_Click" Style="{StaticResource RoundedButton}" Height="35" Padding="12,6" FontSize="15"/> 
                    </StackPanel>-->
                </StackPanel>

                
            </DockPanel>
        </Border>
    </Grid>

</UserControl>
