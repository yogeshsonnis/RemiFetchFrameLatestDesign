<UserControl x:Class="RemiFetchFrame.Views.Extract_From_E01.ExtractFromE012"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RemiFetchFrame.Views.Extract_From_E01"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="#fafafa">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Wizard Header -->
        <Border Grid.Row="0"
            Background="#f5f5f5"
            BorderBrush="#d1d5db"
            BorderThickness="0,0,0,1"
            Padding="20,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                    <Border Background="#e5e7eb" CornerRadius="100" Width="28" Height="28">
                        <TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="#374151" FontWeight="SemiBold"/>
                    </Border>
                    <TextBlock Text=" Select Source " Margin="8,0,0,0"
                           Foreground="#4b5563" FontSize="13"/>
                </StackPanel>

                <Rectangle Fill="#d1d5db" Width="40" Height="1" VerticalAlignment="Center"/>

                <StackPanel Orientation="Horizontal" Margin="10,0,10,0">
                    <Border Background="#1565c0" CornerRadius="100" Width="28" Height="28">
                        <TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="White" FontWeight="SemiBold"/>
                    </Border>
                    <TextBlock Text=" Choose Data Groups " Margin="8,0,0,0"
                           Foreground="#1565c0" FontWeight="SemiBold" FontSize="13"/>
                </StackPanel>

                <Rectangle Fill="#d1d5db" Width="40" Height="1" VerticalAlignment="Center"/>

                <StackPanel Orientation="Horizontal">
                    <Border Background="#e5e7eb" CornerRadius="100" Width="28" Height="28">
                        <TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="#374151" FontWeight="SemiBold"/>
                    </Border>
                    <TextBlock Text=" Extract &amp; Export " Margin="8,0,0,0"
                           Foreground="#4b5563" FontSize="13"/>
                </StackPanel>

            </StackPanel>
        </Border>

        <!-- Body -->
        <Grid Grid.Row="1" Margin="10" Background="White">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Buttons -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                <Button x:Name="BtnSelectAll"
                    Content="Select All"
                    Width="120"
                    Height="32"
                    Margin="0,0,10,0"
                      Style="{StaticResource RoundedButton}"
                    Background="#1565c0"
                    Foreground="White"
                    BorderThickness="0"
                    Click="OnSelectAll"/>

                <Button x:Name="BtnClearAll"
                    Content="Clear All"
                    Width="120"
                    Height="32"
                         Style="{StaticResource RoundedButton}"
                    Background="#1565c0"
                    Foreground="White"
                    BorderThickness="0"
                    Click="OnClearAll"/>
            </StackPanel>

            <!-- ✅ ScrollViewer (NOW WORKING) -->
            <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

                <StackPanel x:Name="DataGroupList">

                    <CheckBox Content="System &amp; OS Artifacts" FontWeight="Bold" Foreground="#1565c0"/>
                    <TextBlock Text="Registry hives, prefetch, SRUDB, scheduled tasks, time zone, services, drivers"
                           FontSize="12" Foreground="#4b5563" Margin="20,0,0,8"/>

                    <CheckBox Content="Incident Response Logs" FontWeight="Bold" Foreground="#1565c0"/>
                    <TextBlock Text="NTUSER.DAT, USRCLASS.DAT, AppCompatCache, AmCache.hve, SRUM, ShimCache, Security.evtx, SysEvent.evtx, AppEvent.evtx"
                           FontSize="12" Foreground="#4b5563" Margin="20,0,0,8"/>

                    <CheckBox Content="Event Logs &amp; Diagnostics" FontWeight="Bold" Foreground="#1565c0"/>
                    <TextBlock Text="Windows Event Logs (System, Security, Application), Reliability, CBS logs, WER reports"
                           FontSize="12" Foreground="#4b5563" Margin="20,0,0,8"/>

                    <CheckBox Content="Network &amp; Browser Activity" FontWeight="Bold" Foreground="#1565c0"/>
                    <TextBlock Text="Wi-Fi profiles, DNS cache, Chrome, Edge, Firefox, Tor, proxy, cookies, downloads"
                           FontSize="12" Foreground="#4b5563" Margin="20,0,0,8"/>

                    <CheckBox Content="Email Archives &amp; Mail Clients" FontWeight="Bold" Foreground="#1565c0"/>
                    <TextBlock Text="Outlook PST/OST, Thunderbird, MBOX, cached Exchange/IMAP content"
                           FontSize="12" Foreground="#4b5563" Margin="20,0,0,8"/>

                    <CheckBox Content="Cloud &amp; Sync Data" FontWeight="Bold" Foreground="#1565c0"/>
                    <TextBlock Text="OneDrive, Google Drive, Dropbox, Box, sync logs, cached credentials, shortcuts"
                           FontSize="12" Foreground="#4b5563" Margin="20,0,0,8"/>

                    <CheckBox Content="Messaging &amp; Social Media" FontWeight="Bold" Foreground="#1565c0"/>
                    <TextBlock Text="WhatsApp, Telegram, Signal, Discord, Messenger, Slack, Skype, Teams"
                           FontSize="12" Foreground="#4b5563" Margin="20,0,0,8"/>

                    <CheckBox Content="Applications &amp; Usage" FontWeight="Bold" Foreground="#1565c0"/>
                    <TextBlock Text="Program installs, crash dumps, MRU lists, JumpLists, run keys, usage history"
                           FontSize="12" Foreground="#4b5563" Margin="20,0,0,8"/>

                    <CheckBox Content="Virtual Machines &amp; Containers" FontWeight="Bold" Foreground="#1565c0"/>
                    <TextBlock Text="VM snapshots, VMDK/VHD, Docker layers, Hyper-V configs, guest OS logs"
                           FontSize="12" Foreground="#4b5563" Margin="20,0,0,8"/>

                    <CheckBox Content="USB &amp; Peripheral Devices" FontWeight="Bold" Foreground="#1565c0"/>
                    <TextBlock Text="Mounted devices, setupapi.dev.log, volume serials, usage timestamps"
                           FontSize="12" Foreground="#4b5563" Margin="20,0,0,8"/>

                    <CheckBox Content="Printing &amp; Document History" FontWeight="Bold" Foreground="#1565c0"/>
                    <TextBlock Text="Print spooler logs, recent file lists, PDF readers’ activity"
                           FontSize="12" Foreground="#4b5563" Margin="20,0,0,8"/>

                    <CheckBox Content="Security &amp; Forensics Artifacts" FontWeight="Bold" Foreground="#1565c0"/>
                    <TextBlock Text="Antivirus logs, Defender scans, BitLocker, audit policies, EFS certificates"
                           FontSize="12" Foreground="#4b5563" Margin="20,0,0,8"/>

                    <CheckBox Content="Performance &amp; Resource Monitoring" FontWeight="Bold" Foreground="#1565c0"/>
                    <TextBlock Text="SRUM data, power logs, resource tracking databases"
                           FontSize="12" Foreground="#4b5563" Margin="20,0,0,8"/>

                    <CheckBox Content="Deleted Files &amp; Recovery Artifacts" FontWeight="Bold" Foreground="#1565c0"/>
                    <TextBlock Text="$Recycle.Bin, shadow copies, carved deleted files, file remnants"
                           FontSize="12" Foreground="#4b5563" Margin="20,0,0,8"/>

                    <CheckBox Content="Custom &amp; Case-Specific Artifacts" FontWeight="Bold" Foreground="#1565c0"/>
                    <TextBlock Text="Keyword search hits, tagged directories, bookmarks, forensic templates"
                           FontSize="12" Foreground="#4b5563" Margin="20,0,0,8"/>

                </StackPanel>
            </ScrollViewer>

            <!-- Footer --><!--
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="BtnNext"
                    Content="Next →"
                    Width="120"
                    Height="32"
                    Background="#1565c0"
                    Foreground="White"
                    BorderThickness="0"
                    Click="OnNext"/>
            </StackPanel>-->

        </Grid>
    </Grid>


</UserControl>
