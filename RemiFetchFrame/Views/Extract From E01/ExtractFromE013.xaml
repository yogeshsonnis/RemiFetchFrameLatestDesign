<UserControl x:Class="RemiFetchFrame.Views.Extract_From_E01.ExtractFromE013"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RemiFetchFrame.Views.Extract_From_E01"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid  Background="#fafafa">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Wizard Header -->
        <Border Grid.Row="0" Background="#f5f5f5" BorderBrush="#d1d5db" BorderThickness="0,0,0,1" Padding="20,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                    <Border Background="#e5e7eb" CornerRadius="100" Width="28" Height="28">
                        <TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#374151" FontWeight="SemiBold"/>
                    </Border>
                    <TextBlock Text=" Select Source " Margin="8,0,0,0" Foreground="#4b5563" FontSize="13"/>
                </StackPanel>
                <Rectangle Fill="#d1d5db" Width="40" Height="1" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" Margin="10,0,10,0">
                    <Border Background="#e5e7eb" CornerRadius="100" Width="28" Height="28">
                        <TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#374151" FontWeight="SemiBold"/>
                    </Border>
                    <TextBlock Text=" Choose Data Types " Margin="8,0,0,0" Foreground="#4b5563" FontSize="13"/>
                </StackPanel>
                <Rectangle Fill="#d1d5db" Width="40" Height="1" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal">
                    <Border Background="#1565c0" CornerRadius="100" Width="28" Height="28">
                        <TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontWeight="SemiBold"/>
                    </Border>
                    <TextBlock Text=" Extract &amp; Export " Margin="8,0,0,0" Foreground="#1565c0" FontSize="13" FontWeight="SemiBold"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Main Body -->
        <StackPanel Grid.Row="1" Margin="10" Background="White"  Orientation="Vertical">
            <!-- Header -->
            <StackPanel Orientation="Horizontal"  Margin="0,0,0,15">
                <TextBlock Text="Step 3: Collect &amp; Export Status" FontSize="16" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#1f2937"/>
                <Button x:Name="BtnStart" Content="Start" Width="120" Height="32" Background="#1565c0" Foreground="White" Style="{StaticResource RoundedButton}" BorderThickness="0" Click="OnStart" Margin="30,0,0,0"/>
            </StackPanel>

            <!-- Progress -->
            <Border BorderBrush="#d1d5db" BorderThickness="1" CornerRadius="6" Padding="15" Background="#f9fafb" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="Collecting files and preparing export package…" Foreground="#374151" FontSize="13" Margin="0,0,0,5"/>
                    <ProgressBar x:Name="ExportProgress" Value="65" Height="10" Foreground="#1565c0" Background="#e5e7eb" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal" >
                        <TextBlock Text="65 % Completed" FontSize="12" Foreground="#4b5563"/>
                        <TextBlock Text="ETA 00:01:32" FontSize="12" Foreground="#4b5563"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Summary Cards -->
            <UniformGrid Columns="3" Rows="1" Margin="0,0,0,10" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                <!-- Export Summary -->
                <Border BorderBrush="#d1d5db" BorderThickness="1" CornerRadius="6" Padding="15" Background="White" Margin="5">
                    <StackPanel>
                        <TextBlock Text="Export Summary" FontWeight="SemiBold" FontSize="14" Foreground="#1f2937" Margin="0,0,0,8"/>
                        <TextBlock Text="Files Collected: 235" FontSize="12" Foreground="#374151"/>
                        <TextBlock Text="Data Size: 4.3 GB" FontSize="12" Foreground="#374151"/>
                        <TextBlock Text="Format: Forensic ZIP" FontSize="12" Foreground="#374151"/>
                        <TextBlock Text="Location: E:/Case123/Exports/" FontSize="12" Foreground="#374151"/>
                    </StackPanel>
                </Border>

                <!-- Chain of Custody -->
                <Border BorderBrush="#d1d5db" BorderThickness="1" CornerRadius="6" Padding="15" Background="White" Margin="5">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal"  Margin="0,0,0,8">
                            <TextBlock Text="Chain of Custody" FontWeight="SemiBold" FontSize="14" Foreground="#1f2937"/>
                            <ToggleButton x:Name="ChainToggle" Margin="10,0,0,0" Style="{StaticResource SwitchToggleStyle}" />
                        </StackPanel>
                        <TextBox Text="Custodian" Margin="0,0,0,6" FontSize="12" Padding="4" BorderBrush="#d1d5db"/>
                        <TextBox Text="Agency" Margin="0,0,0,6" FontSize="12" Padding="4" BorderBrush="#d1d5db"/>
                        <TextBox Text="Examiner" FontSize="12" Padding="4" BorderBrush="#d1d5db"/>
                    </StackPanel>
                </Border>

                <!-- Metrics -->
                <Border BorderBrush="#d1d5db" BorderThickness="1" CornerRadius="6" Padding="15" Background="White" Margin="5">
                    <StackPanel>
                        <TextBlock Text="Metrics" FontWeight="SemiBold" FontSize="14" Foreground="#1f2937" Margin="0,0,0,8"/>
                        <TextBlock Text="Average File Size: 56 KB" FontSize="12" Foreground="#374151"/>
                        <TextBlock Text="Processing Rate: 42 files/s" FontSize="12" Foreground="#374151"/>
                        <TextBlock Text="Errors Detected: 0" FontSize="12" Foreground="#374151"/>
                        <TextBlock Text="Duration: 2 m 31 s" FontSize="12" Foreground="#374151"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </StackPanel>
    </Grid>

</UserControl>
