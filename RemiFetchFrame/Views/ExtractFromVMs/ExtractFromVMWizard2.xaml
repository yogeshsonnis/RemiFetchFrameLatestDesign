<UserControl x:Class="Remi.Fetch.Views.ExtractFromVMs.ExtractFromVMWizard2"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Remi.Fetch.Views.ExtractFromVMs"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Border Background="White" CornerRadius="8" 
                BorderBrush="#D1D5DB" BorderThickness="1"
                SnapsToDevicePixels="True">
            <DockPanel>
                <!-- Wizard Header -->
                <Border Background="#F5F5F5"
        BorderBrush="#D1D5DB"
        BorderThickness="0,0,0,1"
        DockPanel.Dock="Top"
        Padding="10,4">

                    <StackPanel Orientation="Horizontal"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Margin="0,0">

                        <!-- STEP 1 -->
                        <Grid Width="28" Height="28">
                            <Ellipse Fill="#E5E7EB"/>
                            <TextBlock Text="1"
                       Foreground="#374151"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
                        </Grid>

                        <TextBlock Text="  Select Source"
                   Foreground="#6B7280"
                   FontSize="14" VerticalAlignment="Center"
                   Margin="0,0"/>

                        <Rectangle Width="60" Height="2"
                   Fill="#D1D5DB"
                   Margin="12,0"/>

                        <!-- STEP 2 (ACTIVE) -->
                        <Grid Width="28" Height="28">
                            <Ellipse Fill="#1565C0"/>
                            <TextBlock Text="2"
                       Foreground="White"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
                        </Grid>

                        <TextBlock Text="  Choose Data Types"
                   Foreground="#1565C0"
                   FontWeight="SemiBold"
                   FontSize="14" VerticalAlignment="Center"
                   Margin="6,0"/>

                        <Rectangle Width="60" Height="2"
                   Fill="#D1D5DB"
                   Margin="12,0"/>

                        <!-- STEP 3 -->
                        <Grid Width="28" Height="28">
                            <Ellipse Fill="#E5E7EB"/>
                            <TextBlock Text="3"
                       Foreground="#374151"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
                        </Grid>

                        <TextBlock Text="  Extract &amp; Export"
                   Foreground="#6B7280"
                   FontSize="14" VerticalAlignment="Center"
                   Margin="6,0"/>

                    </StackPanel>
                </Border>


                <!-- Main Body -->
                <Grid Background="#F7F9FC" Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Buttons -->
                    <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,8">
                        <Button Content="Select All" Style="{StaticResource RoundedButton}" Height="35" Background="#1565C0" Foreground="White"
                                FontSize="13" Padding="12,6" Margin="0,0,8,0"/>
                        <Button Content="Clear All" Background="#1565C0" Height="35" Style="{StaticResource RoundedButton}" Foreground="White"
                                FontSize="13" Padding="12,6"/>
                    </StackPanel>

                    <!-- Checklist -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" 
                                  BorderBrush="#E5E7EB" BorderThickness="1" 
                                  Background="#F9FAFB" Padding="10">
                        <StackPanel >
                            <CheckBox Content="System &amp; OS Artifacts – Registry hives, event logs, prefetch, SRUDB, scheduled tasks, services" Style="{StaticResource CheckBoxStyle}"
                                      Foreground="#1565C0" FontWeight="Medium" Margin="0,8"/>
                            <CheckBox Content="Network &amp; Browser Activity – History, cache, cookies, Wi-Fi profiles, DNS logs" Style="{StaticResource CheckBoxStyle}"
                                      Foreground="#1565C0" FontWeight="Medium" Margin="0,8"/>
                            <CheckBox Content="User Communications – Email, chat apps (Teams, Slack, Skype)"
                                      Foreground="#1565C0" FontWeight="Medium" Margin="0,8" Style="{StaticResource CheckBoxStyle}"/>
                            <CheckBox Content="Applications &amp; Usage – Installed apps, recent activity, crash data" Style="{StaticResource CheckBoxStyle}"
                                      Foreground="#1565C0" FontWeight="Medium" Margin="0,8"/>
                            <CheckBox Content="Media &amp; Files – Images, videos, EXIF data, temp files" Style="{StaticResource CheckBoxStyle}"
                                      Foreground="#1565C0" FontWeight="Medium" Margin="0,8"/>
                            <CheckBox Content="Financial &amp; Payment Data – Bank exports, QuickBooks, Venmo, PayPal" Style="{StaticResource CheckBoxStyle}"
                                      Foreground="#1565C0" FontWeight="Medium" Margin="0,8"/>
                            <CheckBox Content="Virtualization &amp; Cloud – VM traces, OneDrive, Dropbox, Google Drive" Style="{StaticResource CheckBoxStyle}"
                                      Foreground="#1565C0" FontWeight="Medium" Margin="0,8"/>
                            <CheckBox Content="Memory &amp; Volatile Data – RAM snapshots, hiberfil.sys, pagefile.sys, live process data" Style="{StaticResource CheckBoxStyle}"
                                      Foreground="#1565C0" FontWeight="Medium" Margin="0,8"/>

                            <!--<StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                                <Button x:Name="BtnNext"
        Content="Next →"
        Width="120"
        Style="{StaticResource RoundedButton}"    
        Height="32"
        Background="#1565c0"
        Foreground="White"
        BorderThickness="0"
        Click="OnNext"/>
                            </StackPanel>-->
                        </StackPanel>
                        
                        
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>

</UserControl>
