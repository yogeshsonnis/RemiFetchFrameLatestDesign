<UserControl x:Class="RemiFetchFrame.Views.ExtractFromVMs.ExtractFromVMWizard3"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RemiFetchFrame.Views.ExtractFromVMs"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid  Background="#fafafa">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Wizard Header -->
        <Border Grid.Row="0" Background="#f5f5f5"
                BorderBrush="#d1d5db" BorderThickness="0,0,0,1"
                Padding="20,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- Step 1 -->
                <Border Width="28" Height="28" CornerRadius="14" Background="#e5e7eb"
                        VerticalAlignment="Center" Margin="0,0,4,0">
                    <TextBlock Text="1" Foreground="#374151" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Select VM Source" Foreground="#4b5563"
                           FontSize="13" Margin="4,0,8,0" VerticalAlignment="Center"/>

                <Rectangle Fill="#d1d5db" Width="40" Height="1" VerticalAlignment="Center" Margin="5,0"/>

                <!-- Step 2 -->
                <Border Width="28" Height="28" CornerRadius="14" Background="#e5e7eb"
                        VerticalAlignment="Center" Margin="0,0,4,0">
                    <TextBlock Text="2" Foreground="#374151" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Inspect Disks" Foreground="#4b5563"
                           FontSize="13" Margin="4,0,8,0" VerticalAlignment="Center"/>

                <Rectangle Fill="#d1d5db" Width="40" Height="1" VerticalAlignment="Center" Margin="5,0"/>

                <!-- Step 3 -->
                <Border Width="28" Height="28" CornerRadius="14" Background="#1565c0"
                        VerticalAlignment="Center" Margin="0,0,4,0">
                    <TextBlock Text="3" Foreground="White" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Extract &amp; Export" Foreground="#1565c0"
                           FontWeight="SemiBold" VerticalAlignment="Center" FontSize="13" Margin="4,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10" Background="White" >

                <TextBlock Text="Step 3 – Extract Data &amp; Export Results"
                           FontSize="16" FontWeight="SemiBold" Foreground="#1f2937" Margin="0,0,0,15"/>

                <!-- Action Buttons -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Content="Start Extraction" Style="{StaticResource RoundedButton}" Width="140" Height="30" Margin="0,0,8,0"
                            Background="#1565c0" Foreground="White" BorderBrush="#1565c0"
                            FontSize="12" Click="OnStartExtraction"/>
                    <Button Content="Pause" Width="100"  Style="{StaticResource RoundedButton}" Height="30" Margin="0,0,8,0"
                            Background="#1565c0" Foreground="White" BorderBrush="#1565c0"
                            FontSize="12" Click="OnPause"/>
                    <Button Content="Cancel" Width="100" Height="30"
                            Background="#e11d48" Foreground="White" BorderBrush="#e11d48"
                            FontSize="12" Click="OnCancel"/>
                </StackPanel>

                <!-- Extraction Progress Table -->
                <Border BorderBrush="#d1d5db" BorderThickness="1" CornerRadius="6"
                        Padding="15" Background="#f9fafb" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="Extraction Progress"
                                   FontWeight="SemiBold" FontSize="14"
                                   Foreground="#1f2937" Margin="0,0,0,8"/>
                        <DataGrid x:Name="ExtractionGrid"
                                  AutoGenerateColumns="False" CanUserAddRows="False"
                                  HeadersVisibility="Column" RowHeaderWidth="0"
                                  AlternatingRowBackground="#f9fafb"
                                  Background="White" BorderBrush="#d1d5db" BorderThickness="1"
                                  FontSize="12" Height="200">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="File Path" Binding="{Binding FilePath}" Width="3*"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/>
                                <DataGridTextColumn Header="Progress" Binding="{Binding Progress}" Width="*"/>
                                <DataGridTextColumn Header="Destination" Binding="{Binding Destination}" Width="2*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <ProgressBar x:Name="ExtractionProgress" Value="65" Height="10"
                                     Foreground="#1565c0" Background="#e5e7eb"
                                     Margin="0,10,0,6"/>
                        <DockPanel>
                            <TextBlock Text="65% Completed" DockPanel.Dock="Left"
                                       FontSize="12" Foreground="#4b5563"/>
                            <TextBlock Text="ETA 00:03:40" DockPanel.Dock="Right"
                                       FontSize="12" Foreground="#4b5563"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Summary Cards -->
                <UniformGrid Columns="3" Rows="1" Margin="0,0,0,10">
                    <!-- Export Summary -->
                    <Border BorderBrush="#d1d5db" BorderThickness="1" CornerRadius="6"
                            Padding="15" Background="#f9fafb" Margin="5">
                        <StackPanel>
                            <TextBlock Text="Export Summary" FontWeight="SemiBold" FontSize="14"
                                       Foreground="#1f2937" Margin="0,0,0,6"/>
                            <TextBlock Text="Files Extracted: 512" FontSize="12" Foreground="#374151"/>
                            <TextBlock Text="Total Data: 4.2 GB" FontSize="12" Foreground="#374151"/>
                            <TextBlock Text="Destination: E:/Exports/VM_Extraction/" FontSize="12" Foreground="#374151"/>
                        </StackPanel>
                    </Border>

                    <!-- Verification -->
                    <Border BorderBrush="#d1d5db" BorderThickness="1" CornerRadius="6"
                            Padding="15" Background="#f9fafb" Margin="5">
                        <StackPanel>
                            <TextBlock Text="Verification Summary" FontWeight="SemiBold" FontSize="14"
                                       Foreground="#1f2937" Margin="0,0,0,6"/>
                            <TextBlock Text="Integrity Check: Passed" FontSize="12" Foreground="#374151"/>
                            <TextBlock Text="Hash Algorithm: SHA-256" FontSize="12" Foreground="#374151"/>
                            <TextBlock Text="Errors: 0" FontSize="12" Foreground="#374151"/>
                        </StackPanel>
                    </Border>

                    <!-- Notes -->
                    <Border BorderBrush="#d1d5db" BorderThickness="1" CornerRadius="6"
                            Padding="15" Background="#f9fafb" Margin="5">
                        <StackPanel>
                            <TextBlock Text="Chain of Custody" FontWeight="SemiBold" FontSize="14"
                                       Foreground="#1f2937" Margin="0,0,0,6"/>
                            <Label Content="Examiner:" FontSize="12" Foreground="#374151"/>
                            <TextBox x:Name="TxtExaminer" FontSize="12" Padding="4" BorderBrush="#d1d5db" Margin="0,0,0,6"/>
                            <Label Content="Notes:" FontSize="12" Foreground="#374151"/>
                            <TextBox x:Name="TxtNotes" FontSize="12" Padding="4" BorderBrush="#d1d5db"
                                     TextWrapping="Wrap" AcceptsReturn="True" Height="60"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Footer -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button x:Name="BtnBack" Content="← Back"
                            Width="100" Height="32" Background="#e5e7eb"
                            Foreground="#1f2937" BorderBrush="#d1d5db"
                            FontSize="13" Margin="0,0,8,0" Click="OnBack" Style="{StaticResource NormalButtonStyle}"/>
                    <Button x:Name="BtnFinish" Content="Finish ✓"
                            Width="120" Height="32" Background="#1565c0"
                            Foreground="White" BorderBrush="#1565c0"
                            FontSize="13" Click="OnFinish" Style="{StaticResource RoundedButton}"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>

</UserControl>
