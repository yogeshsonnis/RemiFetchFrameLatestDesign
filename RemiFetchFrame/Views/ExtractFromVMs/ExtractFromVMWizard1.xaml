<UserControl x:Class="RemiFetchFrame.Views.ExtractFromVMs.ExtractFromVMWizard1"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
              xmlns:local="clr-namespace:RemiFetchFrame.Views.ExtractFromVMs"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Border Background="#FAFAFA"  
                BorderBrush="#D1D5DB" BorderThickness="1">
            <DockPanel>
                <!-- Wizard Header -->
                <Border Background="#F5F5F5" BorderBrush="#D1D5DB"
        BorderThickness="0,0,0,1" DockPanel.Dock="Top" Padding="10,4">

                    <StackPanel Orientation="Horizontal"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Margin="0,0">

                        <!-- STEP 1 -->
                        <Grid Width="28" Height="28">
                            <Ellipse Fill="#1565C0"/>
                            <TextBlock Text="1"
                       Foreground="White"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
                        </Grid>

                        <TextBlock Text="  Select Source"
                   Foreground="#1565C0"
                   FontWeight="SemiBold"
                   FontSize="14"
                   Margin="0,0" VerticalAlignment="Center"/>

                        <Rectangle Width="60" Height="2" Fill="#D1D5DB" Margin="12,0"/>

                        <!-- STEP 2 -->
                        <Grid Width="28" Height="28">
                            <Ellipse Fill="#E5E7EB"/>
                            <TextBlock Text="2"
                       Foreground="#374151"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
                        </Grid>

                        <TextBlock Text="  Choose Data Types"
                   Foreground="#6B7280"
                   FontWeight="Medium"
                   FontSize="14"
                   Margin="0,0" VerticalAlignment="Center"/>

                        <Rectangle Width="60" Height="2" Fill="#D1D5DB" Margin="12,0"/>

                        <!-- STEP 3 -->
                        <Grid Width="28" Height="28">
                            <Ellipse Fill="#E5E7EB"/>
                            <TextBlock Text="3"
                       Foreground="#374151"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
                        </Grid>

                        <TextBlock Text="  Extract &amp; Export"
                   Foreground="#6B7280"
                   FontWeight="Medium"
                   FontSize="14"
                   Margin="0,0" VerticalAlignment="Center"/>

                    </StackPanel>
                </Border>


                <!-- Main Body -->
                <Grid Background="#F7F9FC" Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Metrics Summary -->
                    <Border BorderBrush="#E5E7EB" BorderThickness="1"
                            CornerRadius="6" Padding="10" Background="#F9FAFB" Margin="0,0,0,10">
                        <UniformGrid Columns="3" Margin="5,0">
                            <StackPanel>
                                <TextBlock Text="Total Sources Imported:" Foreground="#374151" FontSize="13"/>
                                <TextBlock Text="5" FontWeight="Bold" Foreground="#111827"/>
                                <TextBlock Text="Combined Size:" Foreground="#374151" FontSize="13"/>
                                <TextBlock Text="42.6 GB" FontWeight="Bold" Foreground="#111827"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Integrity Check:" Foreground="#374151" FontSize="13"/>
                                <TextBlock Text="Passed" Foreground="#16A34A" FontWeight="Bold"/>
                                <TextBlock Text="Files Located:" Foreground="#374151" FontSize="13"/>
                                <TextBlock Text="35,482" FontWeight="Bold" Foreground="#111827"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Duplicates Ignored:" Foreground="#374151" FontSize="13"/>
                                <TextBlock Text="1" FontWeight="Bold" Foreground="#111827"/>
                                <TextBlock Text="Unique Volumes:" Foreground="#374151" FontSize="13"/>
                                <TextBlock Text="3" FontWeight="Bold" Foreground="#111827"/>
                            </StackPanel>
                        </UniformGrid>
                    </Border>

                    <!-- Action Buttons -->
                    <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,0,0,10">
                        <Button Content="Add Folder..." Height="35" Style="{StaticResource RoundedButton}" Background="#1565C0" Foreground="White"
                                  FontSize="12" Margin="0,0,6,0"/>
                        <Button Content="Remove Selected" Width="100" Style="{StaticResource NormalButtonStyle}" Background="#E5E7EB" Foreground="#111827"
                                Padding="12,6" FontSize="12" Margin="0,0,6,0"/>
                        <Button Content="Clear List" Background="#E5E7EB" Width="80" Style="{StaticResource NormalButtonStyle}" Foreground="#111827"
                                Padding="12,6" FontSize="12"/>
                    </StackPanel>

                    <!-- Table -->
                    <Border Grid.Row="2" BorderBrush="#E5E7EB" BorderThickness="1"
                            CornerRadius="6" Background="White" Margin="0">
                        <DataGrid AutoGenerateColumns="False" HeadersVisibility="Column"
                                  CanUserAddRows="False" BorderBrush="#D1D5DB"
                                  Background="White" Foreground="#374151" FontSize="12" >
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Filename / Source" Binding="{Binding Filename}" Width="*"/>
                                <DataGridTextColumn Header="Source Path" Binding="{Binding SourcePath}" Width="2*"/>
                                <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="Auto"/>
                                <DataGridTextColumn Header="Volume Count" Binding="{Binding VolumeCount}" Width="Auto"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="Auto"/>
                            </DataGrid.Columns>
                            <DataGrid.RowDetailsTemplate>
                                <DataTemplate>
                                    <TextBlock Text="No sources imported." Foreground="#6B7280"
                                               FontSize="13" Padding="8"/>
                                </DataTemplate>
                            </DataGrid.RowDetailsTemplate>
                        </DataGrid>
                    </Border>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>

</UserControl>
