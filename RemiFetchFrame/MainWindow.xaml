<Window x:Class="RemiFetchFrame.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RemiFetchFrame"
        mc:Ignorable="d"
         Width="600"
  Height="750"
  WindowStartupLocation="CenterScreen"
WindowStyle="ToolWindow"  >

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
            <Image Source="/Images/FetchSplash.jpg" 
           Stretch="Uniform" VerticalAlignment="Top" Height="540"/>

        <StackPanel Orientation="Vertical" Grid.Row="1">
            <TextBlock FontSize="80" FontFamily="Segoe UI" FontWeight="Black" VerticalAlignment="Top" HorizontalAlignment="Center" >
<Run Text="REMI" Foreground="#1F1F1F"/>
<Run Text="&amp;" Foreground="#B3B3B3"/>
<Run Text="FETCH" Foreground="#B7D83E"/>
            </TextBlock>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Text="Advanced Data Collections" FontWeight="Bold" FontSize="20" Margin="0,0,0,0"/>
                <TextBlock Text="Cyber Forensic.ai" FontSize="20" FontWeight="SemiBold" Foreground="#909091" Margin="70,0,0,0"/>
            </StackPanel>
        </StackPanel>
        <!--<StackPanel --><!--x:Name="LicenseOverlay"-->
                <!--VerticalAlignment="Bottom"
                HorizontalAlignment="Left"
                Margin="0,0,0,40">
            <TextBlock Foreground="White" FontSize="11" FontWeight="Bold"
                   Text="Data Preservation for Modern Investigations" Margin="10,0,0,0"/>
            <TextBlock Foreground="White" FontSize="12"
                   Text="{Binding LicenseSummary}"/>--><!--
        </StackPanel>-->

     
    </Grid>


</Window>
