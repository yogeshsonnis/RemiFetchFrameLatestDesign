<Window x:Class="RemiFetchFrame.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RemiFetchFrame"
        mc:Ignorable="d"
         Width="1400"
  Height="900"
  WindowStartupLocation="CenterScreen"
WindowStyle="ToolWindow"  >

    <Grid>
        <Image Source="/Images/FetchSplash.png"
           Stretch="UniformToFill"/>

        <StackPanel x:Name="LicenseOverlay"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Left"
                Margin="40,0,0,40">
            <TextBlock Foreground="White" FontSize="14" FontWeight="Bold"
                   Text="Data Preservation for Modern Investigations"/>
            <TextBlock Foreground="White" FontSize="12"
                   Text="{Binding LicenseSummary}"/>
        </StackPanel>

     
    </Grid>


</Window>
